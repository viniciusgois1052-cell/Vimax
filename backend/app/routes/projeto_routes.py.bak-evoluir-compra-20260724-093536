            tarefa.id: tarefa
            for tarefa in projeto.tarefas
        }

        for item in itens:
            tarefa = tarefas.get(
                to_int(item.get('id'))
            )

            if not tarefa:
                continue

            aplicar_dados_tarefa(tarefa, item)

            if 'parent_id' in item:
                parent_id = to_int(
                    item.get('parent_id')
                )

                if parent_id:
                    pai = tarefas.get(parent_id)

                    if not pai:
                        raise ValueError(
                            'Tarefa pai inválida'
                        )

                    if tarefa_eh_descendente(tarefa, pai):
                        raise ValueError(
                            'A hierarquia criaria um ciclo'
                        )

                tarefa.parent_id = parent_id

        atualizar_wbs(projeto)
        db.session.commit()

        return jsonify({
            'success': True,
            'projeto': projeto.to_dict(
                incluir_detalhes=True
            ),
        }), 200

    except ValueError as exc:
        db.session.rollback()

        return jsonify({
            'success': False,
            'error': str(exc),
        }), 400

    except Exception as exc:
        return erro_banco(
            'Erro ao salvar tarefas',
            exc,
        )


