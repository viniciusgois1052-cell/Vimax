class ErroRecursoProjeto(ValueError):
    def __init__(self, mensagem, status_code=400):
        super().__init__(mensagem)
        self.status_code = status_code


def _empresa_ids_usuario_projeto(usuario):
    ids = set()

    if not usuario:
        return ids

    getter = getattr(usuario, 'get_empresa_ids', None)

    if callable(getter):
        try:
            for empresa_id in getter() or []:
                if empresa_id is not None:
                    ids.add(int(empresa_id))
        except Exception:
            pass

    empresa_id = getattr(usuario, 'empresa_id', None)

    if empresa_id is not None:
        try:
            ids.add(int(empresa_id))
        except (TypeError, ValueError):
            pass

    empresas = getattr(usuario, 'empresas', None)

    if empresas:
        try:
            for empresa in empresas:
                valor = getattr(empresa, 'id', empresa)

                if valor is not None:
                    ids.add(int(valor))
        except Exception:
            pass

    return ids


def validar_usuario_recurso_projeto(
    projeto,
    usuario_id,
    recurso_id=None,
):
    if not usuario_id:
        return None

    usuario_recurso = Usuario.query.get(usuario_id)

    if not usuario_recurso:
        raise ErroRecursoProjeto(
            'Usuário não encontrado',
            404,
        )

    if (
        hasattr(usuario_recurso, 'ativo')
        and usuario_recurso.ativo is False
    ):
        raise ErroRecursoProjeto(
            'Este usuário está inativo',
            400,
        )

    empresa_projeto_id = getattr(
        projeto,
        'empresa_principal_id',
        None,
    )

    if empresa_projeto_id:
        empresas_usuario = _empresa_ids_usuario_projeto(
            usuario_recurso
        )

        if int(empresa_projeto_id) not in empresas_usuario:
            raise ErroRecursoProjeto(
                'O usuário não possui acesso à empresa deste projeto',
                403,
            )

    duplicado = ProjetoRecurso.query.filter_by(
        projeto_id=projeto.id,
        usuario_id=usuario_id,
    )

    if recurso_id:
        duplicado = duplicado.filter(
            ProjetoRecurso.id != recurso_id
        )

    if duplicado.first():
        raise ErroRecursoProjeto(
            'Este usuário já foi adicionado ao projeto',
            409,
        )

    return usuario_recurso


