def tarefa_eh_descendente(tarefa, possivel_pai):
    """
    Impede ciclos na hierarquia.

    Exemplo inválido:
    Tarefa A é pai de B e B passa a ser pai de A.
    """

    atual = possivel_pai
    visitados = set()

    while atual:
        if atual.id in visitados:
            return True

        visitados.add(atual.id)

        if atual.id == tarefa.id:
            return True

        atual = atual.pai

    return False


def atualizar_wbs(projeto):
    """
    Reorganiza:
    - ordem;
    - nível;
    - código WBS;
    - tarefas-resumo;
    - datas das tarefas-resumo;
    - percentual das tarefas-resumo;
    - percentual e datas do projeto.
    """

    tarefas = list(projeto.tarefas)

    filhos_por_pai = {}

    for tarefa in tarefas:
        filhos_por_pai.setdefault(
            tarefa.parent_id,
            []
        ).append(tarefa)

    for lista in filhos_por_pai.values():
        lista.sort(
            key=lambda item: (
                item.ordem if item.ordem is not None else 999999,
                item.id or 0,
            )
        )

    ordem_global = 0
    visitados = set()

    def processar(pai_id=None, prefixo='', nivel=0):
        nonlocal ordem_global

        filhos = filhos_por_pai.get(pai_id, [])

        for indice, tarefa in enumerate(filhos, start=1):
            if tarefa.id in visitados:
                continue

            visitados.add(tarefa.id)

            ordem_global += 1
            tarefa.ordem = ordem_global
            tarefa.nivel = nivel
            tarefa.wbs = (
                '{}.{}'.format(prefixo, indice)
                if prefixo else str(indice)
            )

            processar(
                tarefa.id,
                tarefa.wbs,
                nivel + 1,
            )

            sub_tarefas = filhos_por_pai.get(
                tarefa.id,
                []
            )

            tarefa.e_resumo = bool(sub_tarefas)

            if sub_tarefas:
                inicios = [
                    item.data_inicio
                    for item in sub_tarefas
                    if item.data_inicio
                ]

                finais = [
                    item.data_fim
                    for item in sub_tarefas
                    if item.data_fim
                ]

                if inicios:
                    tarefa.data_inicio = min(inicios)

                if finais:
                    tarefa.data_fim = max(finais)

                peso_total = sum(
                    max(item.duracao_minutos or 0, 1)
                    for item in sub_tarefas
                )

                progresso_total = sum(
                    max(item.duracao_minutos or 0, 1)
                    * (item.percentual_concluido or 0)
                    for item in sub_tarefas
                )

                if peso_total:
                    tarefa.percentual_concluido = round(
                        progresso_total / peso_total,
                        2,
                    )

    processar()

    # Caso exista uma tarefa com parent_id inválido,
    # ela volta para a raiz.
    tarefas_nao_visitadas = [
        tarefa
        for tarefa in tarefas
        if tarefa.id not in visitados
    ]

    for tarefa in tarefas_nao_visitadas:
        tarefa.parent_id = None

    if tarefas_nao_visitadas:
        atualizar_wbs(projeto)
        return

    tarefas_folha = [
        tarefa
        for tarefa in tarefas
        if not tarefa.e_resumo and not tarefa.inativa
    ]

    inicios = [
        tarefa.data_inicio
        for tarefa in tarefas_folha
        if tarefa.data_inicio
    ]

    finais = [
        tarefa.data_fim
        for tarefa in tarefas_folha
        if tarefa.data_fim
    ]

    if inicios:
        projeto.data_inicio = min(inicios)

    if finais:
        projeto.data_fim_prevista = max(finais)

    projeto.calcular_percentual()

    custo_planejado = Decimal('0')
    custo_real = Decimal('0')

    for tarefa in tarefas_folha:
        custo_planejado += (
            tarefa.custo_fixo or Decimal('0')
        )

        custo_real += (
            tarefa.custo_real or Decimal('0')
        )

        for alocacao in tarefa.alocacoes:
            custo_planejado += (
                alocacao.custo_planejado
                or Decimal('0')
            )

            custo_real += (
                alocacao.custo_real
                or Decimal('0')
            )

    projeto.custo_planejado = custo_planejado
    projeto.custo_real = custo_real


