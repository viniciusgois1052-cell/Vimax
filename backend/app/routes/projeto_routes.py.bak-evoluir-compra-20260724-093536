        gerente_id = to_int(request.args.get('gerente_id'))
        busca = str(request.args.get('busca') or '').strip()

        if status:
            query = query.filter(
                Projeto.status == status
            )

        if prioridade:
            query = query.filter(
                Projeto.prioridade == prioridade
            )

        if grupo_id:
            query = query.filter(
                Projeto.grupo_id == grupo_id
            )

        if gerente_id:
            query = query.filter(
                Projeto.gerente_id == gerente_id
            )

        if empresa_id:
