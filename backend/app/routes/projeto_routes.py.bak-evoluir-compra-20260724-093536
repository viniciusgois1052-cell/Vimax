STATUS_PROJECAO_COMPRA = {
    'Em levantamento',
    'Pronto para cotar',
    'Enviado para Compras',
    'Em cotação',
    'Comprado',
    'Recebido',
    'Cancelado',
}


def _normalizar_setor_projecao(valor):
    texto = str(valor or '').strip().lower()

    if texto in {'ti', 't.i', 't.i.', 'tecnologia', 'tecnologia da informação'}:
        return 'T.I.'

    if texto in {'manutencao', 'manutenção'}:
        return 'Manutenção'

    if not texto:
        raise ValueError('Setor é obrigatório')

    return str(valor).strip()[:50]


def _validar_responsavel_projecao(projeto, responsavel_id):
    if not responsavel_id:
        return None

    responsavel = Usuario.query.get(responsavel_id)

    if not responsavel:
        raise ValueError('Responsável não encontrado')

    if (
        hasattr(responsavel, 'ativo')
        and responsavel.ativo is False
    ):
        raise ValueError('O responsável está inativo')

    return responsavel

def _preencher_projecao_compra(
    registro,
    dados,
    projeto,
    usuario,
    novo=False,
):
    registro.projeto_id = projeto.id

    # A empresa será escolhida somente ao evoluir para Compras.
    # Registros antigos permanecem com a empresa já armazenada.
    if novo and not registro.empresa_id:
        registro.empresa_id = None

    if novo or 'setor' in dados:
        registro.setor = _normalizar_setor_projecao(
            dados.get('setor')
        )

    if novo or 'item_id' in dados:
        item_id = to_int(dados.get('item_id'))
        item_catalogo = Item.query.get(item_id) if item_id else None

        if item_id and not item_catalogo:
            raise ValueError('Item do catálogo não encontrado')

        if (
            item_catalogo
            and hasattr(item_catalogo, 'ativo')
            and item_catalogo.ativo is False
        ):
            raise ValueError('O item do catálogo está inativo')

        registro.item_id = item_id

        if item_catalogo:
            if not dados.get('nome_item'):
                registro.nome_item = item_catalogo.nome

            if not dados.get('descricao'):
                registro.descricao = item_catalogo.descricao

            if not dados.get('unidade_medida'):
                registro.unidade_medida = (
                    item_catalogo.unidade_medida or 'UN'
                )

            if dados.get('valor_unitario_estimado') in (None, ''):
                registro.valor_unitario_estimado = to_decimal(
                    item_catalogo.preco_unitario,
                    0,
                )

    if novo or 'nome_item' in dados:
        nome_item = str(
            dados.get('nome_item')
            or registro.nome_item
            or ''
        ).strip()

        if not nome_item:
            raise ValueError('Nome do item é obrigatório')

        registro.nome_item = nome_item[:255]

    if 'descricao' in dados:
        registro.descricao = (
            str(dados.get('descricao')).strip()
            if dados.get('descricao') else None
        )

    if 'observacao' in dados:
        registro.observacao = (
            str(dados.get('observacao')).strip()
            if dados.get('observacao') else None
        )

    if novo or 'quantidade' in dados:
        quantidade = to_decimal(
            dados.get('quantidade'),
            1,
        )

        if quantidade <= 0:
            raise ValueError(
                'A quantidade precisa ser maior que zero'
            )

        registro.quantidade = quantidade

    if novo or 'unidade_medida' in dados:
        registro.unidade_medida = str(
            dados.get('unidade_medida')
            or registro.unidade_medida
            or 'UN'
        ).strip()[:20]

    if 'data_necessaria' in dados or novo:
        valor_data = dados.get('data_necessaria')

        if valor_data:
            data_necessaria = parse_datetime(valor_data)

            if not data_necessaria:
                raise ValueError('Data necessária inválida')

            registro.data_necessaria = data_necessaria
        else:
            registro.data_necessaria = None

    if novo or 'valor_unitario_estimado' in dados:
        valor = to_decimal(
            dados.get('valor_unitario_estimado'),
            registro.valor_unitario_estimado or 0,
        )

        if valor < 0:
            raise ValueError(
                'O valor estimado não pode ser negativo'
            )

        registro.valor_unitario_estimado = valor

    if novo or 'responsavel_id' in dados:
        responsavel_id = to_int(
            dados.get('responsavel_id')
        )

        _validar_responsavel_projecao(
            projeto,
            responsavel_id,
        )

        registro.responsavel_id = responsavel_id

    if novo or 'status' in dados:
        status = str(
            dados.get('status')
            or 'Em levantamento'
        ).strip()

        if status not in STATUS_PROJECAO_COMPRA:
            raise ValueError(
                'Status da projeção inválido'
            )

        registro.status = status

    if novo:
        registro.criado_por_id = (
            usuario.id if usuario else None
        )

    registro.atualizado_por_id = (
        usuario.id if usuario else None
    )


@projeto_bp.route(
    '/<int:projeto_id>/projecoes-compras',
    methods=['GET'],
)
def listar_projecoes_compra(projeto_id):
    usuario, erro = exigir_permissao('ver')

    if erro:
        return erro

    projeto, erro = obter_projeto(
        projeto_id,
        usuario,
    )

    if erro:
        return erro

    query = ProjetoProjecaoCompra.query.filter_by(
        projeto_id=projeto.id,
        ativo=True,
    )

    setor = (request.args.get('setor') or '').strip()
    status = (request.args.get('status') or '').strip()

    if setor:
        query = query.filter(
            ProjetoProjecaoCompra.setor
            == _normalizar_setor_projecao(setor)
        )

    if status:
        query = query.filter(
            ProjetoProjecaoCompra.status == status
        )

    itens = query.order_by(
        ProjetoProjecaoCompra.setor,
        ProjetoProjecaoCompra.data_necessaria,
        ProjetoProjecaoCompra.id,
    ).all()

    total_estimado = Decimal('0')
    total_enviado = Decimal('0')
    por_setor = {}

    for item in itens:
        total = (
            (item.quantidade or Decimal('0'))
            * (
                item.valor_unitario_estimado
                or Decimal('0')
            )
        )

        total_estimado += total

        if item.requisicao_id:
            total_enviado += total

        por_setor.setdefault(item.setor, Decimal('0'))
        por_setor[item.setor] += total

    return jsonify({
        'itens': [
            item.to_dict()
            for item in itens
        ],
        'resumo': {
            'quantidade_itens': len(itens),
            'total_estimado': float(total_estimado),
            'total_enviado_compras': float(total_enviado),
            'total_pendente': float(
                total_estimado - total_enviado
            ),
            'por_setor': {
                setor_nome: float(valor)
                for setor_nome, valor in por_setor.items()
            },
        },
    }), 200


