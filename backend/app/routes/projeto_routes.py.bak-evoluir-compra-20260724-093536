    try:
        alocacao = ProjetoAlocacao.query.filter_by(
            tarefa_id=tarefa.id,
            recurso_id=recurso.id,
        ).first()

        if not alocacao:
            alocacao = ProjetoAlocacao(
                tarefa_id=tarefa.id,
                recurso_id=recurso.id,
            )

            db.session.add(alocacao)

        alocacao.unidades_percentual = to_float(
            dados.get('unidades_percentual'),
