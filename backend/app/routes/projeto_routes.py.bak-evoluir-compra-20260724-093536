        return erro

    dados = request.get_json() or {}

    tarefa = ProjetoTarefa.query.filter_by(
        id=to_int(dados.get('tarefa_id')),
        projeto_id=projeto.id,
    ).first()

    recurso = ProjetoRecurso.query.filter_by(
