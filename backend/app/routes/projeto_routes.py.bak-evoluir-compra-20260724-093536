def dependencia_cria_ciclo(projeto_id, predecessora_id, sucessora_id):
    dependencias = (
        ProjetoDependencia.query
        .join(
            ProjetoTarefa,
            ProjetoDependencia.predecessora_id
            == ProjetoTarefa.id,
        )
        .filter(
            ProjetoTarefa.projeto_id == projeto_id
        )
        .all()
    )

    grafo = {}

    for dependencia in dependencias:
        grafo.setdefault(
            dependencia.predecessora_id,
            set(),
        ).add(dependencia.sucessora_id)

    grafo.setdefault(
        predecessora_id,
        set(),
    ).add(sucessora_id)

    pilha = [sucessora_id]
    visitados = set()

    while pilha:
        atual = pilha.pop()

        if atual == predecessora_id:
            return True

        if atual in visitados:
            continue

        visitados.add(atual)
        pilha.extend(grafo.get(atual, []))

    return False


@projeto_bp.route(
    '/<int:projeto_id>/dependencias',
    methods=['POST'],
)
def criar_dependencia(projeto_id):
    usuario, erro = exigir_permissao('editar')

    if erro:
        return erro

    projeto, erro = obter_projeto(
        projeto_id,
        usuario,
    )

    if erro:
        return erro

    dados = request.get_json() or {}

    predecessora_id = to_int(
        dados.get('predecessora_id')
    )

    sucessora_id = to_int(
        dados.get('sucessora_id')
    )

    tipo = str(
        dados.get('tipo') or 'FS'
    ).upper()

    if not predecessora_id or not sucessora_id:
        return jsonify({
            'success': False,
            'error': (
                'Predecessora e sucessora são obrigatórias'
            ),
        }), 400

    if predecessora_id == sucessora_id:
        return jsonify({
            'success': False,
            'error': (
                'Uma tarefa não pode depender dela mesma'
            ),
        }), 400

    if tipo not in TIPOS_DEPENDENCIA:
        return jsonify({
            'success': False,
            'error': 'Tipo de dependência inválido',
        }), 400

    predecessora = ProjetoTarefa.query.filter_by(
        id=predecessora_id,
        projeto_id=projeto.id,
    ).first()

    sucessora = ProjetoTarefa.query.filter_by(
        id=sucessora_id,
        projeto_id=projeto.id,
    ).first()

    if not predecessora or not sucessora:
        return jsonify({
            'success': False,
            'error': 'Tarefa inválida',
        }), 400

    if dependencia_cria_ciclo(
        projeto.id,
        predecessora_id,
        sucessora_id,
    ):
        return jsonify({
            'success': False,
            'error': (
                'A dependência criaria um ciclo'
            ),
        }), 400

    try:
        existente = ProjetoDependencia.query.filter_by(
            predecessora_id=predecessora_id,
            sucessora_id=sucessora_id,
        ).first()

        if existente:
            existente.tipo = tipo
            existente.atraso_minutos = to_int(
                dados.get('atraso_minutos'),
                0,
            )

            dependencia = existente
        else:
            dependencia = ProjetoDependencia(
                predecessora_id=predecessora_id,
                sucessora_id=sucessora_id,
                tipo=tipo,
                atraso_minutos=to_int(
                    dados.get('atraso_minutos'),
                    0,
                ),
            )

            db.session.add(dependencia)

        db.session.commit()

        return jsonify(
            dependencia.to_dict()
        ), 201

    except Exception as exc:
        return erro_banco(
            'Erro ao criar dependência',
            exc,
        )


