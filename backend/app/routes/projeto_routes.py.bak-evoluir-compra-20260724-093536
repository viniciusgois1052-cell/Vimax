@projeto_bp.route(
    '/<int:projeto_id>/tarefas/reordenar',
    methods=['POST'],
)
def reordenar_tarefas(projeto_id):
    usuario, erro = exigir_permissao('editar')

    if erro:
        return erro

    projeto, erro = obter_projeto(
        projeto_id,
        usuario,
    )

    if erro:
        return erro

    dados = request.get_json() or {}
    itens = dados.get('tarefas', [])

    if not isinstance(itens, list):
        return jsonify({
            'success': False,
            'error': 'Lista de tarefas inválida',
        }), 400

    try:
        tarefas = {
            tarefa.id: tarefa
            for tarefa in projeto.tarefas
        }

        for indice, item in enumerate(itens):
            tarefa_id = to_int(item.get('id'))
            tarefa = tarefas.get(tarefa_id)

            if not tarefa:
                continue

            parent_id = to_int(item.get('parent_id'))

            if parent_id:
                pai = tarefas.get(parent_id)

                if not pai:
                    raise ValueError(
                        'Tarefa pai inválida'
                    )

                if tarefa_eh_descendente(tarefa, pai):
                    raise ValueError(
                        'A hierarquia criaria um ciclo'
                    )

            tarefa.parent_id = parent_id
            tarefa.ordem = to_int(
                item.get('ordem'),
                indice + 1,
            )

        atualizar_wbs(projeto)
        db.session.commit()

        return jsonify([
            tarefa.to_dict()
            for tarefa in sorted(
                projeto.tarefas,
                key=lambda item: item.ordem,
            )
        ]), 200

    except ValueError as exc:
        db.session.rollback()

        return jsonify({
            'success': False,
            'error': str(exc),
        }), 400

    except Exception as exc:
        return erro_banco(
            'Erro ao reordenar tarefas',
            exc,
        )


