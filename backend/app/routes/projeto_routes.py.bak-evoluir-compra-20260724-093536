@projeto_bp.route('/dashboard', methods=['GET'])
def dashboard():
    usuario, erro = exigir_permissao('ver')

    if erro:
        return erro

    try:
        projetos = (
            query_projetos_permitidos(usuario)
            .filter(Projeto.ativo.is_(True))
            .all()
        )

        agora = datetime.utcnow()

        por_status = {
            status: 0
            for status in STATUS_PROJETO
        }

        por_prioridade = {
            prioridade: 0
            for prioridade in PRIORIDADES_PROJETO
        }

        atrasados = 0
        vencendo = 0
        concluidos = 0

        orcamento_total = Decimal('0')
        custo_planejado = Decimal('0')
        custo_real = Decimal('0')

        for projeto in projetos:
            por_status[projeto.status] = (
                por_status.get(projeto.status, 0) + 1
            )

            por_prioridade[projeto.prioridade] = (
                por_prioridade.get(
                    projeto.prioridade,
                    0,
                ) + 1
            )

            if projeto.status == 'concluido':
                concluidos += 1

            if (
                projeto.data_fim_prevista
                and projeto.data_fim_prevista < agora
                and projeto.status not in {
                    'concluido',
                    'cancelado',
                    'arquivado',
                }
            ):
                atrasados += 1

            if projeto.data_fim_prevista:
                dias = (
                    projeto.data_fim_prevista - agora
                ).days

                if (
                    0 <= dias <= 7
                    and projeto.status not in {
                        'concluido',
                        'cancelado',
                        'arquivado',
                    }
                ):
                    vencendo += 1

            orcamento_total += projeto.orcamento or 0
            custo_planejado += projeto.custo_planejado or 0
            custo_real += projeto.custo_real or 0

        progresso_medio = 0

        if projetos:
            progresso_medio = round(
                sum(
                    projeto.percentual_concluido or 0
                    for projeto in projetos
                ) / len(projetos),
                2,
            )

        return jsonify({
            'success': True,
            'total': len(projetos),
            'atrasados': atrasados,
            'vencendo_7_dias': vencendo,
            'concluidos': concluidos,
            'progresso_medio': progresso_medio,
            'orcamento_total': float(orcamento_total),
            'custo_planejado': float(custo_planejado),
            'custo_real': float(custo_real),
            'variacao_custo': float(
                custo_real - custo_planejado
            ),
            'por_status': por_status,
            'por_prioridade': por_prioridade,
        }), 200

    except Exception as exc:
        return erro_banco(
            'Erro ao carregar o dashboard',
            exc,
        )


