def aplicar_dados_projeto(projeto, dados):
    campos_texto = {
        'nome',
        'descricao',
    }

    for campo in campos_texto:
        if campo in dados:
            valor = dados.get(campo)
            setattr(
                projeto,
                campo,
                valor.strip() if isinstance(valor, str) else valor,
            )

    if 'codigo' in dados:
        codigo = str(dados.get('codigo') or '').strip()

        if codigo:
            existente = Projeto.query.filter(
                Projeto.codigo == codigo,
                Projeto.id != projeto.id,
            ).first()

            if existente:
                raise ValueError(
                    'Já existe um projeto com este código'
                )

            projeto.codigo = codigo

    if 'status' in dados:
        status = str(dados.get('status') or '').lower()

        if status not in STATUS_PROJETO:
            raise ValueError('Status do projeto inválido')

        projeto.status = status

    if 'prioridade' in dados:
        prioridade = str(
            dados.get('prioridade') or ''
        ).lower()

        if prioridade not in PRIORIDADES_PROJETO:
            raise ValueError('Prioridade inválida')

        projeto.prioridade = prioridade

    if 'modo_agendamento' in dados:
        modo = str(
            dados.get('modo_agendamento') or ''
        ).lower()

        if modo not in MODOS_AGENDAMENTO:
            raise ValueError(
                'Modo de agendamento inválido'
            )

        projeto.modo_agendamento = modo

    campos_data = {
        'data_inicio',
        'data_fim_prevista',
        'data_fim_real',
        'data_limite',
    }

    for campo in campos_data:
        if campo in dados:
            setattr(
                projeto,
                campo,
                parse_datetime(dados.get(campo)),
            )

    if 'percentual_concluido' in dados:
        projeto.percentual_concluido = limitar_percentual(
            dados.get('percentual_concluido')
        )

    for campo in {
        'orcamento',
        'custo_planejado',
        'custo_real',
    }:
        if campo in dados:
            setattr(
                projeto,
                campo,
                to_decimal(dados.get(campo)),
            )

    for campo in {
        'publico',
        'ativo',
    }:
        if campo in dados:
            setattr(
                projeto,
                campo,
                to_bool(dados.get(campo)),
            )

    if 'grupo_id' in dados:
        grupo_id = to_int(dados.get('grupo_id'))

        if grupo_id and not ProjetoGrupo.query.get(grupo_id):
            raise ValueError('Grupo não encontrado')

        projeto.grupo_id = grupo_id

    if 'empresa_principal_id' in dados:
        empresa_id = to_int(
            dados.get('empresa_principal_id')
        )

        if empresa_id and not validar_empresa(empresa_id):
            raise ValueError('Empresa principal não encontrada')

        projeto.empresa_principal_id = empresa_id

    if 'gerente_id' in dados:
        gerente_id = to_int(dados.get('gerente_id'))

        if gerente_id and not validar_usuario(gerente_id):
            raise ValueError('Gerente não encontrado')

        projeto.gerente_id = gerente_id

    if 'empresas_ids' in dados:
        ids = {
            to_int(item)
            for item in dados.get('empresas_ids', [])
            if to_int(item)
        }

        empresas = (
            Empresa.query
            .filter(Empresa.id.in_(ids))
            .all()
            if ids else []
        )

        encontrados = {
            empresa.id
            for empresa in empresas
        }

        faltantes = ids - encontrados

        if faltantes:
            raise ValueError(
                'Uma ou mais empresas não foram encontradas'
            )

        projeto.empresas = empresas

    if (
        projeto.data_inicio
        and projeto.data_fim_prevista
        and projeto.data_fim_prevista < projeto.data_inicio
    ):
        raise ValueError(
            'A data final não pode ser anterior à inicial'
        )


def aplicar_dados_tarefa(tarefa, dados):
    if 'nome' in dados:
        nome = str(dados.get('nome') or '').strip()

        if not nome:
            raise ValueError(
                'O nome da tarefa é obrigatório'
            )

        tarefa.nome = nome

    if 'descricao' in dados:
        tarefa.descricao = dados.get('descricao') or None

    if 'anotacoes' in dados:
        tarefa.anotacoes = dados.get('anotacoes') or None

    if 'ordem' in dados:
        tarefa.ordem = max(
            0,
            to_int(dados.get('ordem'), 0),
        )

    if 'modo_agendamento' in dados:
        modo = str(
            dados.get('modo_agendamento') or ''
        ).lower()

        if modo not in MODOS_AGENDAMENTO:
            raise ValueError(
                'Modo de agendamento inválido'
            )

        tarefa.modo_agendamento = modo

    for campo in {
        'data_inicio',
        'data_fim',
        'inicio_real',
        'fim_real',
        'prazo_final',
        'restricao_data',
    }:
        if campo in dados:
            setattr(
                tarefa,
                campo,
                parse_datetime(dados.get(campo)),
            )

    if 'duracao_minutos' in dados:
        tarefa.duracao_minutos = max(
            0,
            to_int(dados.get('duracao_minutos'), 0),
        )

    if 'duracao_dias' in dados:
        tarefa.duracao_minutos = max(
            0,
            int(
                to_float(
                    dados.get('duracao_dias'),
                    0,
                ) * 480
            ),
        )

    if 'trabalho_minutos' in dados:
        tarefa.trabalho_minutos = max(
            0,
            to_int(dados.get('trabalho_minutos'), 0),
        )

    if 'trabalho_real_minutos' in dados:
        tarefa.trabalho_real_minutos = max(
            0,
            to_int(
                dados.get('trabalho_real_minutos'),
                0,
            ),
        )

    if 'percentual_concluido' in dados:
        tarefa.percentual_concluido = limitar_percentual(
            dados.get('percentual_concluido')
        )

    if 'prioridade' in dados:
        tarefa.prioridade = max(
            0,
            min(
                1000,
                to_int(dados.get('prioridade'), 500),
            ),
        )

    if 'restricao_tipo' in dados:
        restricao = str(
            dados.get('restricao_tipo') or 'ASAP'
        ).upper()

        if restricao not in RESTRICOES_TAREFA:
            raise ValueError(
                'Restrição da tarefa inválida'
            )

        tarefa.restricao_tipo = restricao

    for campo in {
        'e_marco',
        'e_resumo',
        'caminho_critico',
        'inativa',
    }:
        if campo in dados:
            setattr(
                tarefa,
                campo,
                to_bool(dados.get(campo)),
            )

    if 'custo_fixo' in dados:
        tarefa.custo_fixo = to_decimal(
            dados.get('custo_fixo')
        )

    if 'custo_real' in dados:
        tarefa.custo_real = to_decimal(
            dados.get('custo_real')
        )

    if 'calendario_id' in dados:
        calendario_id = to_int(
            dados.get('calendario_id')
        )

        if calendario_id:
            calendario = ProjetoCalendario.query.get(
                calendario_id
            )

            if (
                not calendario
                or calendario.projeto_id != tarefa.projeto_id
            ):
                raise ValueError(
                    'Calendário inválido'
                )

        tarefa.calendario_id = calendario_id

    if tarefa.e_marco:
        tarefa.duracao_minutos = 0

        if tarefa.data_inicio:
            tarefa.data_fim = tarefa.data_inicio

    if (
        tarefa.data_inicio
        and tarefa.data_fim
        and tarefa.data_fim < tarefa.data_inicio
    ):
        raise ValueError(
            'O fim da tarefa não pode ser anterior ao início'
        )


