def parse_datetime(valor):
    if not valor:
        return None

    if isinstance(valor, datetime):
        return valor

    texto = str(valor).strip()

    if texto.endswith('Z'):
        texto = texto[:-1] + '+00:00'

    try:
        resultado = datetime.fromisoformat(texto)

        # O banco atual trabalha com datetime sem timezone.
        if resultado.tzinfo:
            resultado = resultado.replace(tzinfo=None)

        return resultado
    except (TypeError, ValueError):
        return None


def to_int(valor, padrao=None):
    if valor in (None, '', 'null', 'undefined'):
        return padrao

    try:
        return int(valor)
    except (TypeError, ValueError):
        return padrao


def to_float(valor, padrao=0):
    if valor in (None, '', 'null', 'undefined'):
        return padrao

    try:
        return float(valor)
    except (TypeError, ValueError):
        return padrao


def to_decimal(valor, padrao=0):
    if valor in (None, '', 'null', 'undefined'):
        return Decimal(str(padrao))

    try:
        return Decimal(str(valor))
    except Exception:
        return Decimal(str(padrao))


def to_bool(valor, padrao=False):
    if valor is None:
        return padrao

    if isinstance(valor, bool):
        return valor

    if isinstance(valor, (int, float)):
        return valor != 0

    return str(valor).strip().lower() in {
        '1',
        'true',
        'sim',
        'yes',
        'on',
    }


def limitar_percentual(valor):
    return max(0, min(100, to_float(valor, 0)))


def usuario_admin(usuario):
    return usuario and usuario.role in {
        'super_admin',
        'admin',
    }


def verificar_permissao(usuario, acao):
    """
    Verifica permissões do módulo Projetos.

    Regras:
    - super_admin: acesso total;
    - admin sem perfil: acesso total;
    - usuário com perfil: projetos_ver, projetos_criar etc.;
    - enquanto as colunas ainda não existirem, admin continua liberado.
    """

    if not usuario:
        return False

    if usuario.role == 'super_admin':
        return True

    perfil = getattr(usuario, 'perfil_acesso', None)

    if usuario.role == 'admin' and not perfil:
        return True

    chave = 'projetos_{}'.format(acao)

    if perfil and hasattr(perfil, chave):
        return bool(getattr(perfil, chave))

    # Compatibilidade enquanto as permissões de projetos
    # ainda não foram adicionadas ao PerfilAcesso.
    return usuario.role == 'admin'


def exigir_permissao(acao):
    usuario = get_current_user_from_request(request)

    if not usuario:
        return None, (
            jsonify({
                'success': False,
                'error': 'Não autenticado',
            }),
            401,
        )

    if not verificar_permissao(usuario, acao):
        return None, (
            jsonify({
                'success': False,
                'error': 'Acesso negado',
            }),
            403,
        )

    return usuario, None


def empresas_do_usuario(usuario):
    if not usuario:
        return []

    try:
        return usuario.get_empresa_ids()
    except Exception:
        ids = []

        if getattr(usuario, 'empresa_id', None):
            ids.append(usuario.empresa_id)

        for empresa in getattr(usuario, 'empresas', []) or []:
            if empresa.id not in ids:
                ids.append(empresa.id)

        return ids


def usuario_acessa_projeto(usuario, projeto):
    if not usuario or not projeto:
        return False

    if usuario_admin(usuario):
        return True

    if projeto.publico:
        return True

    if projeto.gerente_id == usuario.id:
        return True

    if projeto.criado_por_id == usuario.id:
        return True

    ids_permitidos = set(empresas_do_usuario(usuario))

    if not ids_permitidos:
        return False

    if projeto.empresa_principal_id in ids_permitidos:
        return True

    return any(
        empresa.id in ids_permitidos
        for empresa in projeto.empresas
    )


def query_projetos_permitidos(usuario):
    query = Projeto.query

    if usuario_admin(usuario):
        return query

    ids_empresas = empresas_do_usuario(usuario)

    filtros = [
        Projeto.publico.is_(True),
        Projeto.gerente_id == usuario.id,
        Projeto.criado_por_id == usuario.id,
    ]

    if ids_empresas:
        filtros.extend([
            Projeto.empresa_principal_id.in_(ids_empresas),
            Projeto.empresas.any(
                Empresa.id.in_(ids_empresas)
            ),
        ])

    return query.filter(or_(*filtros)).distinct()


def obter_projeto(projeto_id, usuario):
    projeto = Projeto.query.get(projeto_id)

    if not projeto:
        return None, (
            jsonify({
                'success': False,
                'error': 'Projeto não encontrado',
            }),
            404,
        )

    if not usuario_acessa_projeto(usuario, projeto):
        return None, (
            jsonify({
                'success': False,
                'error': 'Acesso negado a este projeto',
            }),
            403,
        )

    return projeto, None


def gerar_codigo_projeto():
    ano = datetime.utcnow().year
    prefixo = 'PRJ-{}-'.format(ano)

    ultimo = (
        Projeto.query
        .filter(Projeto.codigo.like('{}%'.format(prefixo)))
        .order_by(Projeto.id.desc())
        .first()
    )

    sequencia = 1

    if ultimo:
        try:
            sequencia = int(
                ultimo.codigo.split('-')[-1]
            ) + 1
        except (TypeError, ValueError):
            sequencia = ultimo.id + 1

    codigo = '{}{:04d}'.format(
        prefixo,
        sequencia,
    )

    while Projeto.query.filter_by(codigo=codigo).first():
        sequencia += 1
        codigo = '{}{:04d}'.format(
            prefixo,
            sequencia,
        )

    return codigo


