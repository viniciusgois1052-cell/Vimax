            dados.get('trabalho_real_minutos'),
            0,
        )

        horas = Decimal(
            str(alocacao.trabalho_minutos or 0)
        ) / Decimal('60')

        alocacao.custo_planejado = (
            horas * (recurso.custo_hora or 0)
            + (recurso.custo_por_uso or 0)
        )

        alocacao.custo_real = to_decimal(
            dados.get('custo_real')
        )

