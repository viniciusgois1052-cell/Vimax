@compra_bp.route('/ordens/<int:id>/enviar-para-fornecedor', methods=['POST'])
def enviar_ordem_fornecedor(id):
    """POST /api/compras/ordens/<id>/enviar-para-fornecedor - Enviar OC para fornecedor"""
    user = get_current_user_from_request(request)
    ordem = OrdemCompra.query.get_or_404(id)
    data = request.get_json() or {}

    try:
        email_fornecedor = data.get('email_fornecedor') or ordem.email_fornecedor
        mensagem_custom = data.get('mensagem', '')

        if not email_fornecedor:
            return jsonify({"error": "Email do fornecedor não fornecido"}), 400

        # 🆕 Garante que a OC tenha token_portal (para OCs antigas sem token)
        if not ordem.token_portal:
            ordem.token_portal = secrets.token_urlsafe(32)
            db.session.commit()

        # Gerar PDF
        pdf_bytes = PDFService.gerar_pdf_ordem(ordem)

        # Preparar email
        corpo_html = EmailService.template_ordem_enviada(ordem)

        if mensagem_custom:
            corpo_html += f"<p style='margin-top: 20px; border-top: 1px solid #ccc; padding-top: 20px;'><strong>Mensagem adicional:</strong><br>{mensagem_custom}</p>"

        # 🆕 Link do portal para o fornecedor anexar NF e Boleto (usa token_portal + senha da cotação)
        portal_url = os.environ.get('PORTAL_FORNECEDOR_URL', 'https://kilowatt-proxy-kosher.ngrok-free.dev')
        # remove sufixo de rota caso a env venha como .../portal-fornecedor
        portal_base = portal_url.replace('/portal-fornecedor', '').rstrip('/')
        link_oc = f"{portal_base}/oc/{ordem.token_portal}"
        corpo_html += f"""
        <div style='margin-top:24px;padding:16px;background:#ecfdf5;border-left:4px solid #10b981;border-radius:6px;font-family:Arial,sans-serif'>
          <p style='margin:0 0 8px;font-weight:bold;color:#065f46'>📎 Após a entrega, anexe a Nota Fiscal e o Boleto:</p>
          <a href='{link_oc}' style='display:inline-block;padding:12px 24px;background:#10b981;color:white;text-decoration:none;border-radius:6px;font-weight:bold'>
            Anexar NF e Boleto →
          </a>
          <p style='margin:8px 0 0;font-size:12px;color:#6b7280'>Use a mesma senha do portal do fornecedor (válida por 72h). Se expirou, avise o comprador para reenviar.</p>
        </div>"""

        anexos = [{
            'filename': f'ordem_{ordem.numero_oc}.pdf',
            'data': pdf_bytes,
            'mimetype': 'application/pdf'
        }]

        # Enviar email
        resultado = EmailService.send_email(
            destinatarios=email_fornecedor,
            assunto=f'📮 Ordem de Compra {ordem.numero_oc} - {ordem.empresa.nome}',
            corpo_html=corpo_html,
            anexos=anexos
        )

        if resultado['success']:
            # Marcar como enviado
            ordem.pdf_enviado = True
            ordem.data_envio_pdf = datetime.utcnow()
            db.session.commit()

            try:
                create_log(user=user, action='enviar_ordem_fornecedor', entity='ordem', entity_id=id,
                          details={'email': email_fornecedor}, req=request)
            except:
                pass

        return jsonify(resultado)
    except Exception as e:
        current_app.logger.exception("Erro ao enviar ordem para fornecedor")
        return jsonify({"error": str(e)}), 500

