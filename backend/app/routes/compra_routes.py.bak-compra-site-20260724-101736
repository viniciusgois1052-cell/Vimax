@compra_bp.route('/dashboard', methods=['GET'])
def get_dashboard():
    """GET /api/compras/dashboard - Dados do dashboard"""
    try:
        total_requisicoes = RequisicaoCompra.query.filter(RequisicaoCompra.ativo == True).count()
        requisicoes_pendentes = RequisicaoCompra.query.filter(
            RequisicaoCompra.ativo == True,
            RequisicaoCompra.status == StatusRequisicao.PENDENTE_APROVACAO.value
        ).count()
        
        total_pedidos = PedidoCompra.query.filter(PedidoCompra.ativo == True).count()
        total_ordens = OrdemCompra.query.filter(OrdemCompra.ativo == True).count()
        
        valor_total_requisicoes = db.session.query(
            db.func.sum(ItemRequisicao.valor_total)
        ).join(RequisicaoCompra).filter(
            RequisicaoCompra.ativo == True
        ).scalar() or 0
        
        valor_total_pedidos = db.session.query(
            db.func.sum(PedidoCompra.valor_final)
        ).filter(
            PedidoCompra.ativo == True
        ).scalar() or 0

        return jsonify({
            'total_requisicoes': total_requisicoes,
            'requisicoes_pendentes': requisicoes_pendentes,
            'total_pedidos': total_pedidos,
            'total_ordens': total_ordens,
            'valor_total_requisicoes': float(valor_total_requisicoes),
            'valor_total_pedidos': float(valor_total_pedidos)
        })
    except Exception as e:
        current_app.logger.exception("Erro ao gerar dashboard")
        return jsonify({"error": str(e)}), 500

