@compra_bp.route('/pedidos', methods=['POST'])
def create_pedido():
    """POST /api/compras/pedidos - Criar novo pedido"""
    user = get_current_user_from_request(request)
    data = request.get_json() or {}
    
    if not data.get('empresa_id'):
        return jsonify({"error": "Empresa é obrigatória"}), 400
    
    try:
        numero_pc = gerar_numero_sequencial('PC', PedidoCompra)
        
        novo_pedido = PedidoCompra(
            numero_pc=numero_pc,
            status=data.get('status', StatusPedido.RASCUNHO.value),
            requisicao_id=to_int(data.get('requisicao_id')),
            empresa_id=to_int(data.get('empresa_id')),
            fornecedor_id=to_int(data.get('fornecedor_id')),
            usuario_comprador_id=user.id if user else to_int(data.get('usuario_comprador_id')),
            data_entrega_prevista=parse_datetime(data.get('data_entrega_prevista')),
            valor_total=to_float(data.get('valor_total', 0)),
            desconto=to_float(data.get('desconto', 0)),
            condicao_pagamento=data.get('condicao_pagamento'),
            local_entrega=data.get('local_entrega'),
            observacoes=data.get('observacoes'),
            anexos=data.get('anexos', [])
        )
        
        novo_pedido.valor_final = (novo_pedido.valor_total or 0) - (novo_pedido.desconto or 0)
        
        # Adicionar itens
        itens_data = data.get('itens', [])
        for item_data in itens_data:
            item = ItemPedido(
                codigo_item=item_data.get('codigo_item'),
                nome_item=item_data.get('nome_item'),
                quantidade=to_float(item_data.get('quantidade', 1)),
                unidade_medida=item_data.get('unidade_medida', 'UN'),
                valor_unitario=to_float(item_data.get('valor_unitario')),
                item_id=to_int(item_data.get('item_id'))
            )
            item.valor_total = (item.quantidade or 0) * (item.valor_unitario or 0)
            novo_pedido.itens.append(item)
        
        db.session.add(novo_pedido)
        db.session.commit()
        
        # 🆕 Enviar email de novo pedido
        try:
            corpo_html = EmailService.template_pedido_emitido(novo_pedido)
            EmailService.send_email(
                destinatarios=novo_pedido.comprador.email,
                assunto=f'📦 Pedido de Compra Criado: {numero_pc}',
                corpo_html=corpo_html
            )
        except Exception as email_err:
            current_app.logger.error(f"Erro ao enviar email do pedido: {str(email_err)}")
        
        try:
            create_log(user=user, action='create_pedido', entity='pedido', entity_id=novo_pedido.id,
                      details={'numero_pc': numero_pc}, req=request)
        except:
            pass
        
        return jsonify(novo_pedido.to_dict()), 201
    except Exception as e:
        db.session.rollback()
        current_app.logger.exception("Erro ao criar pedido")
        return jsonify({"error": str(e)}), 500

@compra_bp.route('/pedidos/<int:id>', methods=['PUT'])
def update_pedido(id):
    """PUT /api/compras/pedidos/<id> - Atualizar pedido"""
    user = get_current_user_from_request(request)
    pedido = PedidoCompra.query.get_or_404(id)
