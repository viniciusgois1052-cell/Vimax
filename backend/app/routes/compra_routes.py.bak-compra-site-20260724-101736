def parse_datetime(value):
    if not value:
        return None
    try:
        return datetime.fromisoformat(value)
    except Exception:
        return None

def to_int(value):
    try:
        return int(value) if value is not None and value != '' else None
    except Exception:
        return None

def to_float(value):
    try:
        return float(value) if value is not None and value != '' else None
    except Exception:
        return None

def gerar_numero_sequencial(prefixo, modelo):
    """Gera número sequencial: RQ-2026-001, PC-2026-001, OC-2026-001"""
    ano = datetime.now().year
    ultimo = db.session.query(modelo).filter(modelo.ativo == True).order_by(modelo.id.desc()).first()
    numero = 1 if not ultimo else int(getattr(ultimo, f'numero_{prefixo.lower()}').split('-')[-1]) + 1
    return f"{prefixo}-{ano}-{numero:03d}"

def _status_aprovada(status):
    """Reconhece 'Aprovada' (valor do enum) e 'APROVADA' (grafia legada), case-insensitive."""
    if not status:
        return False
    return str(status).strip().upper() in ('APROVADA', StatusRequisicao.APROVADA.value.upper())

def _cors_options():
    from flask import Response
    resp = Response()
    resp.headers['Access-Control-Allow-Origin'] = '*'
    resp.headers['Access-Control-Allow-Methods'] = 'GET, POST, PUT, DELETE, OPTIONS, PATCH'
    resp.headers['Access-Control-Allow-Headers'] = 'Content-Type, Authorization, X-API-Token'
    return resp, 200

