    try:
        if 'status' in data:
            pedido.status = data.get('status')
        if 'fornecedor_id' in data:
            pedido.fornecedor_id = to_int(data.get('fornecedor_id'))
        if 'data_entrega_prevista' in data:
            pedido.data_entrega_prevista = parse_datetime(data.get('data_entrega_prevista'))
        if 'valor_total' in data:
            pedido.valor_total = to_float(data.get('valor_total'))
        if 'desconto' in data:
            pedido.desconto = to_float(data.get('desconto'))
        if 'condicao_pagamento' in data:
            pedido.condicao_pagamento = data.get('condicao_pagamento')
        if 'local_entrega' in data:
            pedido.local_entrega = data.get('local_entrega')
        if 'observacoes' in data:
            pedido.observacoes = data.get('observacoes')
        if 'anexos' in data:
            pedido.anexos = data.get('anexos')
        
        pedido.valor_final = (pedido.valor_total or 0) - (pedido.desconto or 0)
        
        # Atualizar itens se fornecidos
        if 'itens' in data:
            ItemPedido.query.filter_by(pedido_id=pedido.id).delete()
            for item_data in data.get('itens', []):
                item = ItemPedido(
                    pedido_id=pedido.id,
                    codigo_item=item_data.get('codigo_item'),
                    nome_item=item_data.get('nome_item'),
                    quantidade=to_float(item_data.get('quantidade', 1)),
                    unidade_medida=item_data.get('unidade_medida', 'UN'),
                    valor_unitario=to_float(item_data.get('valor_unitario')),
                    item_id=to_int(item_data.get('item_id'))
                )
                item.valor_total = (item.quantidade or 0) * (item.valor_unitario or 0)
                pedido.itens.append(item)
        
        db.session.commit()
        
        try:
            create_log(user=user, action='update_pedido', entity='pedido', entity_id=id,
