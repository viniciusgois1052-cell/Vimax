@compra_bp.route('/requisicoes', methods=['GET'])
def get_requisicoes():
    """GET /api/compras/requisicoes - Listar requisições"""
    try:
        empresa_id = request.args.get('empresa_id')
        status = request.args.get('status')
        api_token = request.headers.get('X-API-Token')
        
        user = None
        if api_token:
            user = Usuario.query.filter_by(api_token=api_token).first()
        
        query = RequisicaoCompra.query.filter(RequisicaoCompra.ativo == True)
        query = apply_entity_filter(query, RequisicaoCompra, empresa_id, user)
        
        if status:
            query = query.filter(RequisicaoCompra.status == status)
        
        requisicoes = query.order_by(RequisicaoCompra.created_at.desc()).all()
        return jsonify([r.to_dict() for r in requisicoes])
    except Exception as e:
        current_app.logger.exception("Erro ao listar requisições")
        return jsonify({"error": str(e)}), 500

@compra_bp.route('/requisicoes/prontas-envio', methods=['GET'])
def get_requisicoes_prontas_envio():
    """
    GET /api/compras/requisicoes/prontas-envio
    Requisições APROVADAS que ainda NÃO possuem um Pedido de Compra vinculado.
    """
    try:
        empresa_id = request.args.get('empresa_id')
        api_token = request.headers.get('X-API-Token')

        user = None
        if api_token:
            user = Usuario.query.filter_by(api_token=api_token).first()

        query = RequisicaoCompra.query.filter(RequisicaoCompra.ativo == True)
        query = apply_entity_filter(query, RequisicaoCompra, empresa_id, user)
        requisicoes = query.order_by(RequisicaoCompra.created_at.desc()).all()

        # ids de requisições que já viraram pedido (ativo)
        pedidos_ativos = PedidoCompra.query.filter(PedidoCompra.ativo == True).all()
        req_com_pedido = {p.requisicao_id for p in pedidos_ativos if p.requisicao_id}

        prontas = [
            r.to_dict() for r in requisicoes
            if _status_aprovada(r.status) and r.id not in req_com_pedido
        ]
        return jsonify(prontas)
    except Exception as e:
        current_app.logger.exception("Erro ao listar requisições prontas para envio")
        return jsonify({"error": str(e)}), 500

