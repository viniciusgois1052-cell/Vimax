@compra_bp.route('/requisicoes/<int:id>/enviar-email', methods=['POST'])
def enviar_email_requisicao(id):
    """POST /api/compras/requisicoes/<id>/enviar-email - Enviar RQ por email"""
    user = get_current_user_from_request(request)
    requisicao = RequisicaoCompra.query.get_or_404(id)
    data = request.get_json() or {}

    try:
        # Gerar PDF
        pdf_bytes = PDFService.gerar_pdf_requisicao(requisicao)

        # Preparar email
        destinatarios = data.get('destinatarios', [requisicao.solicitante.email])
        if isinstance(destinatarios, str):
            destinatarios = [destinatarios]

        corpo_html = EmailService.template_requisicao_criada(requisicao, requisicao.solicitante)

        anexos = [{
            'filename': f'requisicao_{requisicao.numero_rq}.pdf',
            'data': pdf_bytes,
            'mimetype': 'application/pdf'
        }]

        # Enviar email
        resultado = EmailService.send_email(
            destinatarios=destinatarios,
            assunto=f'Requisição de Compra {requisicao.numero_rq} - {requisicao.empresa.nome}',
            corpo_html=corpo_html,
            anexos=anexos
        )

        if resultado['success']:
            try:
                create_log(user=user, action='enviar_email_requisicao', entity='requisicao', entity_id=id,
                          details={'destinatarios': destinatarios}, req=request)
            except:
                pass

        return jsonify(resultado)
    except Exception as e:
        current_app.logger.exception("Erro ao enviar email da requisição")
        return jsonify({"error": str(e)}), 500

