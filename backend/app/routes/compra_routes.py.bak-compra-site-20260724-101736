@compra_bp.route('/requisicoes', methods=['POST'])
def create_requisicao():
    """POST /api/compras/requisicoes - Criar nova requisição"""
    user = get_current_user_from_request(request)
    data = request.get_json() or {}
    
    if not data.get('empresa_id'):
        return jsonify({"error": "Empresa é obrigatória"}), 400
    
    try:
        numero_rq = gerar_numero_sequencial('RQ', RequisicaoCompra)
        
        nova_requisicao = RequisicaoCompra(
            numero_rq=numero_rq,
            status=data.get('status', StatusRequisicao.RASCUNHO.value),
            empresa_id=to_int(data.get('empresa_id')),
            usuario_solicitante_id=user.id if user else to_int(data.get('usuario_solicitante_id')),
            data_necessaria=parse_datetime(data.get('data_necessaria')),
            descricao=data.get('descricao'),
            observacoes=data.get('observacoes'),
            justificativa=data.get('justificativa'),
            anexos=data.get('anexos', [])
        )
        
        # Adicionar itens
        itens_data = data.get('itens', [])
        for item_data in itens_data:
            # Buscar dados do item pelo item_id se nome_item não vier no payload
            item_ref = None
            if item_data.get('item_id'):
                item_ref = Item.query.get(to_int(item_data['item_id']))

            nome_item     = item_data.get('nome_item')     or (item_ref.nome           if item_ref else None)
            codigo_item   = item_data.get('codigo_item')   or (item_ref.codigo         if item_ref else None)
            descricao     = item_data.get('descricao')     or (item_ref.descricao      if item_ref else None)
            unidade       = item_data.get('unidade_medida') or (item_ref.unidade_medida if item_ref else 'UN') or 'UN'
            valor_unit    = to_float(item_data.get('valor_unitario')) or to_float(item_ref.preco_unitario if item_ref else 0)

            item = ItemRequisicao(
                nome_item=nome_item,
                descricao=descricao,
                quantidade=to_float(item_data.get('quantidade', 1)),
                unidade_medida=unidade,
                valor_unitario=valor_unit,
                item_id=to_int(item_data.get('item_id')),
                codigo_item=codigo_item,
                especificacoes=item_data.get('especificacoes') or item_data.get('observacao', '')
            )
            item.valor_total = (item.quantidade or 0) * (item.valor_unitario or 0)
            nova_requisicao.itens.append(item)
        
        db.session.add(nova_requisicao)
        db.session.commit()
        
        try:
            create_log(user=user, action='create_requisicao', entity='requisicao', entity_id=nova_requisicao.id,
                      details={'numero_rq': numero_rq}, req=request)
        except:
            pass
        
        return jsonify(nova_requisicao.to_dict()), 201
    except Exception as e:
        db.session.rollback()
        current_app.logger.exception("Erro ao criar requisição")
        return jsonify({"error": str(e)}), 500

@compra_bp.route('/requisicoes/<int:id>', methods=['PUT'])
def update_requisicao(id):
    """Atualizar requisição existente"""
    try:
        requisicao = RequisicaoCompra.query.get_or_404(id)
        data = request.get_json()

        # Atualizar campos básicos
        if 'empresa_id' in data:
            requisicao.empresa_id = data['empresa_id']
        if 'data_necessaria' in data:
            requisicao.data_necessaria = data['data_necessaria']
        if 'observacao' in data:
            requisicao.observacao = data['observacao']

        # Se houver itens para atualizar, remover os antigos e adicionar os novos
        if 'itens' in data:
            # DELETAR itens antigos
            ItemRequisicao.query.filter_by(requisicao_id=id).delete()
            
            # ADICIONAR novos itens
            for item_data in data['itens']:
                item = Item.query.get(item_data['item_id'])
                if item:
                    novo_item = ItemRequisicao(
                        requisicao_id=id,
                        item_id=item.id,
                        codigo_item=item.codigo,
                        nome_item=item.nome,
                        descricao=item.descricao,
                        quantidade=float(item_data.get('quantidade', 0)),
                        unidade_medida=item.unidade_medida or 'UN',
                        valor_unitario=float(item.preco_unitario or 0),
                        valor_total=float(item_data.get('quantidade', 0)) * float(item.preco_unitario or 0),
                        especificacoes=item_data.get('observacao', '')
                    )
                    db.session.add(novo_item)

        # Recalcular valor total da requisição
        itens = ItemRequisicao.query.filter_by(requisicao_id=id).all()
        requisicao.valor_total = sum(item.valor_total for item in itens)

        db.session.commit()

        return jsonify({
            'success': True,
            'message': 'Requisição atualizada com sucesso',
            'id': requisicao.id
        }), 200

    except Exception as e:
        db.session.rollback()
        current_app.logger.error(f'Erro ao atualizar requisição: {str(e)}')
        return jsonify({
            'success': False,
            'error': 'Erro ao atualizar requisição: ' + str(e)
        }), 500


