    id = db.Column(db.Integer, primary_key=True)

    predecessora_id = db.Column(
        db.Integer,
        db.ForeignKey('projeto_tarefas.id', ondelete='CASCADE'),
        nullable=False,
        index=True
    )

    sucessora_id = db.Column(
        db.Integer,
        db.ForeignKey('projeto_tarefas.id', ondelete='CASCADE'),
        nullable=False,
        index=True
    )

    # FS, SS, FF ou SF
    tipo = db.Column(
        db.String(2),
        default='FS',
        nullable=False
    )

    atraso_minutos = db.Column(
        db.Integer,
        default=0,
        nullable=False
    )

    predecessora = db.relationship(
        'ProjetoTarefa',
        foreign_keys=[predecessora_id],
        back_populates='sucessoras'
    )

    sucessora = db.relationship(
        'ProjetoTarefa',
        foreign_keys=[sucessora_id],
