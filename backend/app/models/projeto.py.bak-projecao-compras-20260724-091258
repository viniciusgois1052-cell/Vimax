        'ProjetoTarefa',
        back_populates='projeto',
        cascade='all, delete-orphan',
        order_by='ProjetoTarefa.ordem'
    )

    recursos = db.relationship(
        'ProjetoRecurso',
        back_populates='projeto',
        cascade='all, delete-orphan'
    )

    calendarios = db.relationship(
        'ProjetoCalendario',
        back_populates='projeto',
        cascade='all, delete-orphan'
    )

    linhas_base = db.relationship(
        'ProjetoLinhaBase',
        back_populates='projeto',
        cascade='all, delete-orphan'
    )

    def calcular_percentual(self):
        tarefas = [
            tarefa
            for tarefa in self.tarefas
            if not tarefa.e_resumo
        ]

        if not tarefas:
            self.percentual_concluido = 0
            return 0

        peso_total = sum(
            max(tarefa.duracao_minutos or 0, 1)
            for tarefa in tarefas
        )

        progresso = sum(
            max(tarefa.duracao_minutos or 0, 1)
            * (tarefa.percentual_concluido or 0)
            for tarefa in tarefas
        )

        self.percentual_concluido = round(
            progresso / peso_total,
            2
        )

        return self.percentual_concluido

    def to_dict(self, incluir_detalhes=False):
        dados = {
            'id': self.id,
            'codigo': self.codigo,
            'nome': self.nome,
            'descricao': self.descricao,
            'status': self.status,
            'prioridade': self.prioridade,
            'modo_agendamento': self.modo_agendamento,
            'grupo_id': self.grupo_id,
            'grupo': self.grupo.to_dict() if self.grupo else None,
            'empresa_principal_id': self.empresa_principal_id,
            'empresa_principal_nome': (
                self.empresa_principal.nome
                if self.empresa_principal else None
            ),
            'empresas': [
                {
                    'id': empresa.id,
                    'nome': empresa.nome,
                    'parent_id': empresa.parent_id
                }
                for empresa in self.empresas
            ],
            'gerente_id': self.gerente_id,
            'gerente_nome': (
                self.gerente.nome_completo or self.gerente.username
                if self.gerente else None
            ),
            'criado_por_id': self.criado_por_id,
            'data_inicio': _iso(self.data_inicio),
            'data_fim_prevista': _iso(self.data_fim_prevista),
            'data_fim_real': _iso(self.data_fim_real),
            'data_limite': _iso(self.data_limite),
            'percentual_concluido': self.percentual_concluido,
            'orcamento': _decimal(self.orcamento),
            'custo_planejado': _decimal(self.custo_planejado),
            'custo_real': _decimal(self.custo_real),
            'publico': self.publico,
            'ativo': self.ativo,
            'quantidade_tarefas': len(self.tarefas),
            'criado_em': _iso(self.criado_em),
            'atualizado_em': _iso(self.atualizado_em)
        }

        if incluir_detalhes:
            dados['tarefas'] = [
                tarefa.to_dict()
                for tarefa in self.tarefas
            ]

            dados['recursos'] = [
                recurso.to_dict()
                for recurso in self.recursos
            ]

            dados['calendarios'] = [
                calendario.to_dict()
                for calendario in self.calendarios
            ]

            dados['linhas_base'] = [
                linha.to_dict(incluir_dados=False)
                for linha in self.linhas_base
            ]

        return dados


