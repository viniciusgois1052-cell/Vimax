# -*- coding: utf-8 -*-

import os
import traceback

from flask import Flask, jsonify, request, send_from_directory
from flask_bcrypt import Bcrypt
from flask_cors import CORS
from flask_mail import Mail
from flask_sqlalchemy import SQLAlchemy


db = SQLAlchemy()
bcrypt = Bcrypt()
mail = Mail()


def create_app(config_class=None):
    """
    Cria e configura a aplicação Flask.

    Responsável por:
    - Carregar configurações;
    - Inicializar banco, bcrypt e e-mail;
    - Configurar CORS;
    - Proteger as rotas da API;
    - Registrar os blueprints;
    - Criar as tabelas que ainda não existem.
    """

    app = Flask(__name__)
    app.url_map.strict_slashes = False

    # ============================================================
    # CONFIGURAÇÃO
    # ============================================================

    if config_class:
        app.config.from_object(config_class)
    else:
        from .config.config import Config
        app.config.from_object(Config)

    # ============================================================
    # EXTENSÕES
    # ============================================================

    db.init_app(app)
    bcrypt.init_app(app)
    mail.init_app(app)

    # ============================================================
    # CORS
    # ============================================================

    allowed_origins = [
        "http://vimax.ad.digimaxdiagnostico.com.br:5173",
        "http://vimax.ad.digimaxdiagnostico.com.br",
        "http://192.168.2.70:5173",
        "http://192.168.2.70",
        "http://localhost:5173",
        "http://localhost:3000",
        os.getenv(
            "PORTAL_FORNECEDOR_URL",
            "https://kilowatt-proxy-kosher.ngrok-free.dev"
        ),
    ]

    CORS(
        app,
        origins=allowed_origins,
        allow_headers=[
            "Content-Type",
            "Authorization",
            "X-API-Token",
            "X-Cron-Token",
            "ngrok-skip-browser-warning",
        ],
        methods=[
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "OPTIONS",
            "PATCH",
        ],
        supports_credentials=True,
        max_age=3600,
    )

    @app.after_request
    def after_request(response):
        """
        Adiciona os cabeçalhos CORS e os cabeçalhos básicos
        de segurança.
        """

        origin = request.headers.get("Origin", "")

        if origin in allowed_origins:
            response.headers["Access-Control-Allow-Origin"] = origin
            response.headers["Vary"] = "Origin"

        response.headers["Access-Control-Allow-Methods"] = (
            "GET, POST, PUT, DELETE, OPTIONS, PATCH"
        )

        response.headers["Access-Control-Allow-Headers"] = (
            "Content-Type, Authorization, X-API-Token, "
            "X-Cron-Token, ngrok-skip-browser-warning"
        )

        response.headers["Access-Control-Max-Age"] = "3600"
        response.headers["X-Content-Type-Options"] = "nosniff"
        response.headers["X-Frame-Options"] = "DENY"
        response.headers["X-XSS-Protection"] = "1; mode=block"
        response.headers["Referrer-Policy"] = (
            "strict-origin-when-cross-origin"
        )

        response.headers.pop("Server", None)

        return response

    # ============================================================
    # AUTENTICAÇÃO GLOBAL
    # ============================================================

    public_prefixes = (
        "/api/usuarios/login",
        "/api/usuarios/logout",
        "/api/public/",
        "/api/cotacoes/portal/",
        "/api/formularios-chamado/public",
        "/api/config/logo/imagem",
        "/api/oc/portal/",
    )

    public_exact = (
        "/health",
        "/",
    )

    @app.before_request
    def require_auth():
        """
        Protege todas as rotas iniciadas por /api/.

        O módulo de projetos também será protegido automaticamente,
        pois utilizará o prefixo /api/projetos.
        """

        if request.method == "OPTIONS":
            return None

        path = request.path

        if path in public_exact:
            return None

        for public_path in public_prefixes:
            if path == public_path or path.startswith(public_path):
                return None

        if not path.startswith("/api/"):
            return None


        cron_paths = {
            "/api/recorrencias/processar",
            "/api/contadores-impressora/atualizar-todas",
        }

        if path in cron_paths:
            import secrets

            configured_cron_token = os.getenv("CRON_TOKEN", "")
            received_cron_token = request.headers.get(
                "X-Cron-Token",
                ""
            )

            if (
                not configured_cron_token
                or not received_cron_token
                or not secrets.compare_digest(
                    received_cron_token,
                    configured_cron_token
                )
            ):
                return jsonify({
                    "error": "Token de cron inválido"
                }), 403

            return None

        from .models.usuario import Usuario

        token = (
            request.headers.get("X-API-Token")
            or request.args.get("token")
        )

        if not token:
            return jsonify({
                "success": False,
                "error": "Não autenticado"
            }), 401

        user = Usuario.query.filter_by(api_token=token).first()

        if not user or not user.token_valido():
            return jsonify({
                "success": False,
                "error": "Token inválido ou expirado"
            }), 401

        return None

    # ============================================================
    # UPLOADS
    # ============================================================

    uploads_dir = os.path.join(
        app.root_path,
        "static",
        "uploads"
    )

    @app.route("/static/uploads/<path:filename>")
    def uploaded_files(filename):
        """
        Serve arquivos enviados ao sistema.

        Aceita o token pelo cabeçalho X-API-Token ou pelo parâmetro
        ?token= para links abertos diretamente no navegador.
        """

        from .models.usuario import Usuario

        token = (
            request.headers.get("X-API-Token")
            or request.args.get("token")
        )

        if not token:
            return jsonify({
                "error": "Não autenticado"
            }), 401

        user = Usuario.query.filter_by(api_token=token).first()

        if not user or not user.token_valido():
            return jsonify({
                "error": "Token inválido"
            }), 401

        return send_from_directory(
            uploads_dir,
            filename
        )

