function ResourcesModal({ project, task, resources, users, reload, close, notify }) {
  const emptyForm = { usuario_id: '', nome: '', email: '', tipo: 'trabalho', custo_hora: 0, capacidade_percentual: 100 }
  const [form, setForm] = useState(emptyForm)
  const assigned = new Map((task?.alocacoes || []).map(item => [Number(item.recurso_id), item]))
  const linkedUserIds = new Set(resources.map(item => Number(item.usuario_id)).filter(Boolean))
  const projectCompanyId = Number(project?.empresa_principal_id || 0)

  const userLabel = item => item?.nome_completo || item?.nome || item?.username || item?.email || `Usuário ${item?.id}`

  const userCompanyIds = item => {
    const result = new Set()
    const add = value => {
      const id = Number(value)
      if (id) result.add(id)
    }

    add(item?.empresa_id)
    ;(item?.empresa_ids || []).forEach(add)
    ;(item?.empresas || []).forEach(company => add(company?.id ?? company))

    return result
  }

  const availableUsers = (users || [])
    .filter(item => {
      if (linkedUserIds.has(Number(item.id))) return false
      if (!projectCompanyId) return true

      const companyIds = userCompanyIds(item)

      // Se a API não devolver empresas, o backend fará a validação final.
      return companyIds.size === 0 || companyIds.has(projectCompanyId)
    })
    .sort((a, b) => userLabel(a).localeCompare(userLabel(b), 'pt-BR'))

  const chooseUser = event => {
    const usuarioId = event.target.value
    const selectedUser = (users || []).find(item => Number(item.id) === Number(usuarioId))

    setForm(current => ({
      ...current,
      usuario_id: usuarioId,
      nome: selectedUser ? userLabel(selectedUser) : '',
      email: selectedUser?.email || '',
      tipo: 'trabalho',
    }))
  }

  const changeType = event => {
    const tipo = event.target.value

    setForm(current => ({
      ...current,
      tipo,
      usuario_id: tipo === 'trabalho' ? current.usuario_id : '',
      nome: tipo === 'trabalho' && current.usuario_id ? current.nome : '',
      email: tipo === 'trabalho' ? current.email : '',
    }))
  }

  const add = async event => {
    event.preventDefault()

    try {
      await api(`${API}/${project.id}/recursos`, {
        method: 'POST',
        body: JSON.stringify({
          ...form,
          usuario_id: form.usuario_id || null,
        }),
      })

      setForm(emptyForm)
      await reload()
      notify(form.usuario_id ? 'Usuário adicionado ao projeto' : 'Recurso criado')
    } catch (error) {
      notify(error.message, 'error')
    }
  }

  const toggle = async resource => {
    if (!task) return notify('Selecione uma tarefa para alocar recursos', 'error')

    const assignment = assigned.get(Number(resource.id))

    try {
      if (assignment) {
        await api(`${API}/${project.id}/alocacoes/${assignment.id}`, {
          method: 'DELETE',
        })
      } else {
        await api(`${API}/${project.id}/alocacoes`, {
          method: 'POST',
          body: JSON.stringify({
            tarefa_id: task.id,
            recurso_id: resource.id,
            unidades_percentual: 100,
            trabalho_minutos: task.trabalho_minutos || task.duracao_minutos || 480,
          }),
        })
      }

      await reload()
      notify(assignment ? 'Recurso removido da tarefa' : 'Recurso alocado')
    } catch (error) {
      notify(error.message, 'error')
    }
  }

  const remove = async resource => {
    if (!window.confirm(`Excluir o recurso "${resource.nome}"?`)) return

    try {
      await api(`${API}/${project.id}/recursos/${resource.id}`, {
        method: 'DELETE',
      })

      await reload()
      notify('Recurso excluído')
    } catch (error) {
      notify(error.message, 'error')
    }
  }

  return (
    <Modal open wide title={`Recursos${task ? ` — alocação em ${task.nome}` : ''}`} close={close}>
      <div className="grid gap-6 p-6 md:grid-cols-[1fr_340px]">
        <div>
          <h3 className="mb-3 text-sm font-black text-slate-700">Responsáveis do projeto</h3>

          {!task && (
            <p className="mb-3 rounded-xl bg-blue-50 p-3 text-xs text-blue-700">
              Selecione uma tarefa para atribuir ou remover recursos.
            </p>
          )}

          <div className="space-y-2">
            {resources.length === 0 ? (
              <p className="rounded-xl bg-slate-50 p-4 text-sm text-slate-400">
                Nenhum recurso cadastrado.
              </p>
            ) : resources.map(resource => (
              <div key={resource.id} className="flex items-center gap-3 rounded-xl border p-3">
                <button
                  type="button"
                  disabled={!task}
                  onClick={() => toggle(resource)}
