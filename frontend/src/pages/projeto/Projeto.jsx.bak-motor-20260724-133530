function DurationEditor({ task, editable, apply, calendar = DEFAULT_CALENDAR }) {
  const current = task.e_marco ? 0 : (task.e_resumo ? workingDaysInclusive(task.data_inicio, task.data_fim, calendar) : taskDuration(task))
  const [open, setOpen] = useState(false)
  const [value, setValue] = useState(current)
  const [position, setPosition] = useState({ top: 0, left: 0 })
  const buttonRef = useRef(null)

  useEffect(() => {
    if (!open) setValue(current)
  }, [current, open])

  const show = event => {
    event.stopPropagation()
    if (!editable) return
    const rect = buttonRef.current.getBoundingClientRect()
    const width = 310
    const height = 250
    setPosition({
      left: Math.max(8, Math.min(rect.left, window.innerWidth - width - 8)),
      top: rect.bottom + height < window.innerHeight ? rect.bottom + 6 : Math.max(8, rect.top - height - 6),
    })
    setValue(current)
    setOpen(true)
  }

  const change = next => setValue(Math.max(0, Math.min(9999, Number(next) || 0)))
  const confirm = () => {
    const duration = task.e_resumo ? Math.max(1, Number(value) || 1) : Math.max(0, Number(value) || 0)
    setOpen(false)
    if (duration === current) return
    apply({
      duracao_dias: duration,
      duracao_minutos: duration * 480,
      e_marco: task.e_resumo ? false : duration === 0,
    })
  }


  return <>
    <button ref={buttonRef} type="button" disabled={!editable} onClick={show} className="flex w-full items-center justify-center gap-1 rounded-md px-1 py-1 text-[10px] font-bold hover:bg-blue-100 hover:text-blue-700 disabled:opacity-50">
      {current} <span className="text-[9px] text-slate-400">d</span>
    </button>
    {open && createPortal(<>
      <button type="button" aria-label="Fechar editor" className="fixed inset-0 z-[9998] cursor-default bg-transparent" onClick={() => setOpen(false)}/>
      <div onClick={event => event.stopPropagation()} className="fixed z-[9999] w-[310px] rounded-2xl border bg-white p-4 shadow-2xl" style={position}>
        <div className="mb-3">
          <b className="block truncate text-sm text-slate-800">{task.e_resumo ? 'Duração do grupo' : 'Duração da tarefa'}</b>
          <span className="block truncate text-[10px] text-slate-400">{task.nome}</span>
        </div>

        {task.e_resumo && <div className="mb-3 rounded-lg bg-blue-50 px-3 py-2 text-[10px] font-medium text-blue-700">A nova duração ajustará somente a tarefa final do grupo. As demais tarefas e predecessoras serão preservadas.</div>}

        <div className="mb-3 grid grid-cols-[48px_1fr_48px] items-center gap-2">
          <button type="button" onClick={() => change(value - 1)} className="h-11 rounded-xl border bg-slate-50 text-2xl font-black text-slate-600 hover:bg-slate-100">−</button>
          <label className="relative">
            <input autoFocus type="number" min="0" max="9999" step="0.5" value={value} onChange={event => change(event.target.value)} onKeyDown={event => { if (event.key === 'Enter') confirm(); if (event.key === 'Escape') setOpen(false) }} className="h-11 w-full rounded-xl border-2 border-blue-500 px-3 pr-11 text-center text-lg font-black outline-none"/>
            <span className="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">dias</span>
          </label>
          <button type="button" onClick={() => change(value + 1)} className="h-11 rounded-xl border bg-slate-50 text-2xl font-black text-slate-600 hover:bg-slate-100">+</button>
        </div>

        <div className="mb-4 grid grid-cols-5 gap-1.5">
          {[1, 5, 10, 15, 20, 30, 45, 60, 90, 120].map(days => <button type="button" key={days} onClick={() => change(days)} className={`rounded-lg border py-1.5 text-[10px] font-bold ${Number(value) === days ? 'border-blue-600 bg-blue-600 text-white' : 'hover:bg-slate-50'}`}>{days}d</button>)}
        </div>

        <div className="flex gap-2">
          {!task.e_resumo && <button type="button" onClick={() => change(0)} className="rounded-xl border px-3 py-2 text-xs font-bold text-violet-600 hover:bg-violet-50">Marco (0d)</button>}
          <button type="button" onClick={confirm} className="flex-1 rounded-xl bg-black px-4 py-2 text-xs font-black text-white hover:bg-slate-800">Aplicar e recalcular</button>
        </div>
      </div>
    </>, document.body)}
  </>
}


function DateEditor({ task, field, editable, apply }) {
  const current = dateOnly(task[field])
  const [open, setOpen] = useState(false)
  const [value, setValue] = useState(current)
  const [position, setPosition] = useState({ top: 0, left: 0 })
  const buttonRef = useRef(null)

  useEffect(() => {
    if (!open) setValue(current)
  }, [current, open])

  const show = event => {
    event.stopPropagation()
    if (!editable) return
    const rect = buttonRef.current.getBoundingClientRect()
    const width = 330
    const height = 270
    setPosition({
      left: Math.max(8, Math.min(rect.left, window.innerWidth - width - 8)),
      top: rect.bottom + height < window.innerHeight ? rect.bottom + 6 : Math.max(8, rect.top - height - 6),
    })
    setValue(current || new Date().toISOString().slice(0, 10))
    setOpen(true)
  }

  const shift = days => setValue(previous => addCalendarDays(previous || new Date().toISOString().slice(0, 10), days))
  const confirm = () => {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return
    setOpen(false)
    if (value !== current) apply(value)
  }

  return <>
    <button ref={buttonRef} type="button" disabled={!editable} onClick={show} title={task.e_resumo ? 'Editar e mover todas as subtarefas' : 'Editar data'} className={`flex w-full items-center justify-between gap-1 rounded-md px-1.5 py-1 text-[10px] hover:bg-blue-100 disabled:opacity-50 ${task.e_resumo ? 'font-black text-blue-700' : 'text-slate-700'}`}>
      <span>{formatDate(current)}</span><CalendarDays className="shrink-0 opacity-60" size={11}/>
    </button>
    {open && createPortal(<>
      <button type="button" aria-label="Fechar calendário" className="fixed inset-0 z-[9998] cursor-default bg-black/5" onClick={() => setOpen(false)}/>
      <div onClick={event => event.stopPropagation()} className="fixed z-[9999] w-[330px] rounded-2xl border bg-white p-4 shadow-2xl" style={position}>
        <div className="mb-3 flex items-start gap-2">
          <CalendarDays className="mt-0.5 text-blue-600" size={18}/>
          <div className="min-w-0"><b className="block text-sm">{field === 'data_inicio' ? 'Data de início' : 'Data de término'}</b><span className="block truncate text-[10px] text-slate-400">{task.nome}</span></div>
        </div>

        {task.e_resumo && <div className="mb-3 rounded-lg bg-amber-50 px-3 py-2 text-[10px] font-medium text-amber-700">Tarefa-resumo: mudar o início move o grupo; mudar o término ajusta a tarefa final que controla a duração.</div>}

        <input autoFocus type="date" min="2000-01-01" max="2100-12-31" value={value} onChange={event => setValue(event.target.value)} onKeyDown={event => { if (event.key === 'Enter') confirm(); if (event.key === 'Escape') setOpen(false) }} className="mb-3 h-12 w-full rounded-xl border-2 border-blue-500 px-4 text-center text-base font-black outline-none"/>

        <div className="mb-3 grid grid-cols-6 gap-1.5">
          {[-30, -7, -1, 1, 7, 30].map(days => <button type="button" key={days} onClick={() => shift(days)} className="rounded-lg border py-1.5 text-[10px] font-bold hover:bg-slate-50">{days > 0 ? '+' : ''}{days}d</button>)}
        </div>

        <div className="mb-4 rounded-xl bg-slate-50 p-3 text-center"><span className="block text-[9px] font-bold uppercase text-slate-400">Data selecionada</span><b className="text-base text-slate-800">{formatDate(value)}</b></div>

        <div className="flex gap-2">
          <button type="button" onClick={() => setValue(new Date().toISOString().slice(0, 10))} className="rounded-xl border px-3 py-2 text-xs font-bold">Hoje</button>
          <button type="button" onClick={() => setOpen(false)} className="rounded-xl border px-3 py-2 text-xs font-bold">Cancelar</button>
          <button type="button" onClick={confirm} className="flex-1 rounded-xl bg-black px-4 py-2 text-xs font-black text-white">Aplicar data</button>
        </div>
      </div>
    </>, document.body)}
  </>
}

function ProjectForm({ project, companies, groups, users, saving, save, cancel }) {
  const [form, setForm] = useState({
    nome: project?.nome || '', codigo: project?.codigo || '', descricao: project?.descricao || '',
    status: project?.status || 'planejamento', prioridade: project?.prioridade || 'normal',
    grupo_id: project?.grupo_id || '',
    empresas_ids: project?.empresas?.map(item => item.id) || [], gerente_id: project?.gerente_id || '',
    data_inicio: dateOnly(project?.data_inicio) || new Date().toISOString().slice(0, 10),
    data_fim_prevista: dateOnly(project?.data_fim_prevista), data_limite: dateOnly(project?.data_limite),
    orcamento: project?.orcamento || 0, modo_agendamento: project?.modo_agendamento || 'automatico', publico: !!project?.publico,
  })
  const set = (key, value) => setForm(previous => ({ ...previous, [key]: value }))
  const submit = event => {
    event.preventDefault()
    save({
      ...form,
      grupo_id: form.grupo_id ? Number(form.grupo_id) : null,
      gerente_id: form.gerente_id ? Number(form.gerente_id) : null,
      empresas_ids: form.empresas_ids.map(Number),
      orcamento: Number(form.orcamento || 0),
    })
  }
  const input = 'w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100'
  const Field = ({ label, children, span = false }) => <label className={span ? 'md:col-span-2' : ''}><span className="mb-1 block text-[11px] font-black uppercase text-slate-500">{label}</span>{children}</label>

  return <form className="grid grid-cols-1 gap-4 p-6 md:grid-cols-2" onSubmit={submit}>
    <Field label="Nome do projeto" span><input className={input} required autoFocus value={form.nome} onChange={event => set('nome', event.target.value)}/></Field>
    <Field label="Código"><input className={input} placeholder="Automático" value={form.codigo} onChange={event => set('codigo', event.target.value)}/></Field>
    <Field label="Grupo / portfólio"><select className={input} value={form.grupo_id} onChange={event => set('grupo_id', event.target.value)}><option value="">Sem grupo</option>{groups.map(item => <option key={item.id} value={item.id}>{item.nome}</option>)}</select></Field>
    <Field label="Empresas participantes"><select className={`${input} min-h-28`} multiple value={form.empresas_ids.map(String)} onChange={event => set('empresas_ids', Array.from(event.target.selectedOptions).map(option => Number(option.value)))}>{companies.map(item => <option key={item.id} value={item.id}>{item.nome}</option>)}</select></Field>
    <Field label="Gerente"><select className={input} value={form.gerente_id} onChange={event => set('gerente_id', event.target.value)}><option value="">Sem gerente</option>{users.map(item => <option key={item.id} value={item.id}>{item.nome_completo || item.username}</option>)}</select></Field>
    <Field label="Status"><select className={input} value={form.status} onChange={event => set('status', event.target.value)}>{Object.entries(STATUS).map(([key, item]) => <option key={key} value={key}>{item[0]}</option>)}</select></Field>
