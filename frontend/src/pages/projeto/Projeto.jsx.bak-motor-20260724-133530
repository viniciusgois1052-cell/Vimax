function Workspace({ initialProject, users, permissions, back, notify }) {
  const [project, setProject] = useState(initialProject)
  const [tasks, setTasks] = useState(initialProject.tarefas || [])
  const [resources, setResources] = useState(initialProject.recursos || [])
  const [calendars, setCalendars] = useState(initialProject.calendarios || [])
  const [baselines, setBaselines] = useState(initialProject.linhas_base || [])
  const [selectedId, setSelectedId] = useState(null)
  const [collapsed, setCollapsed] = useState(new Set())
  const [search, setSearch] = useState('')
  const [zoomIndex, setZoomIndex] = useState(1)
  const [loading, setLoading] = useState(false)
  const [history, setHistory] = useState([])
  const [future, setFuture] = useState([])
  const [dependencyOpen, setDependencyOpen] = useState(false)
  const [resourcesOpen, setResourcesOpen] = useState(false)
  const [calendarOpen, setCalendarOpen] = useState(false)
  const [baselineOpen, setBaselineOpen] = useState(false)
  const [selectedBaselineId, setSelectedBaselineId] = useState(null)
  const [baselineData, setBaselineData] = useState(null)
  const [selectedIds, setSelectedIds] = useState(new Set())
  const [filter, setFilter] = useState('all')
  const [inspectorOpen, setInspectorOpen] = useState(false)
  const [linkSourceId, setLinkSourceId] = useState(null)
  const [dragTaskId, setDragTaskId] = useState(null)
  const [viewport, setViewport] = useState({ top: 0, left: 0, height: 700, width: 1200 })
  const importRef = useRef(null)
  const scrollRef = useRef(null)
  const scrollFrameRef = useRef(null)
  const lastSelectedIndexRef = useRef(null)
  const tasksRef = useRef(tasks)
  const saveTimerRef = useRef(null)
  const queuedSaveRef = useRef(null)
  const persistChainRef = useRef(Promise.resolve())
  const zoom = ZOOMS[zoomIndex]
  const dayWidth = zoom.width
  const selectedTask = tasks.find(item => Number(item.id) === Number(selectedId)) || null
  const calendar = calendars.find(item => item.padrao) || calendars[0] || DEFAULT_CALENDAR

  useEffect(() => { tasksRef.current = tasks }, [tasks])
  useEffect(() => () => {
    if (scrollFrameRef.current) cancelAnimationFrame(scrollFrameRef.current)
  }, [])

  const reload = useCallback(async () => {
    setLoading(true)
    try {
      const value = await api(`${API}/${initialProject.id}`)
      setProject(value); setTasks(value.tarefas || []); setResources(value.recursos || []); setCalendars(value.calendarios || []); setBaselines(value.linhas_base || [])
    } catch (error) { notify(error.message, 'error') } finally { setLoading(false) }
  }, [initialProject.id, notify])

  useEffect(() => { reload() }, [reload])
  useEffect(() => {
    if (!selectedBaselineId) { setBaselineData(null); return }
    api(`${API}/${project.id}/linhas-base/${selectedBaselineId}`).then(value => setBaselineData(value.dados)).catch(error => notify(error.message, 'error'))
  }, [selectedBaselineId, project.id, notify])

  const map = useMemo(() => new Map(tasks.map(item => [Number(item.id), item])), [tasks])
  const childIds = useMemo(() => new Set(tasks.filter(item => item.parent_id != null).map(item => Number(item.parent_id))), [tasks])
  const visibleTasks = useMemo(() => tasks.filter(task => {
    if (search && !`${task.wbs || ''} ${task.nome || ''}`.toLowerCase().includes(search.toLowerCase())) return false
    if (filter === 'critical' && !task.caminho_critico) return false
    if (filter === 'open' && Number(task.percentual_concluido || 0) >= 100) return false
    if (filter === 'done' && Number(task.percentual_concluido || 0) < 100) return false
    if (filter === 'late' && (Number(task.percentual_concluido || 0) >= 100 || dateObj(task.data_fim) >= dateObj(new Date().toISOString().slice(0, 10)))) return false
    let parent = task.parent_id == null ? null : Number(task.parent_id)
    while (parent) {
      if (collapsed.has(parent)) return false
      parent = map.get(parent)?.parent_id == null ? null : Number(map.get(parent)?.parent_id)
    }
    return true
  }), [tasks, search, filter, collapsed, map])

  const baselineMap = useMemo(() => new Map((baselineData?.tarefas || []).map(item => [Number(item.id), item])), [baselineData])
  const range = useMemo(() => {
    const starts = tasks.map(item => dateOnly(item.data_inicio)).filter(Boolean).sort()
    const finishes = tasks.map(item => dateOnly(item.data_fim || item.data_inicio)).filter(Boolean).sort()
    const start = addCalendarDays(starts[0] || dateOnly(project.data_inicio) || new Date().toISOString().slice(0, 10), -14)
    let finish = addCalendarDays(finishes.pop() || dateOnly(project.data_fim_prevista) || start, 45)
    if (diffDays(start, finish) < 90) finish = addCalendarDays(start, 90)
    if (diffDays(start, finish) > 1460) finish = addCalendarDays(start, 1460)
    return { start, finish, days: diffDays(start, finish) + 1 }
  }, [tasks, project.data_inicio, project.data_fim_prevista])
  const timelineWidth = range.days * dayWidth
  const days = useMemo(() => Array.from({ length: range.days }, (_, index) => addCalendarDays(range.start, index)), [range])
  const onViewportScroll = useCallback(event => {
    const element = event.currentTarget
    if (scrollFrameRef.current) cancelAnimationFrame(scrollFrameRef.current)
    scrollFrameRef.current = requestAnimationFrame(() => setViewport({
      top: element.scrollTop,
      left: element.scrollLeft,
      height: element.clientHeight,
      width: element.clientWidth,
    }))
  }, [])
  useEffect(() => {
    const element = scrollRef.current
    if (!element) return
    setViewport({ top: element.scrollTop, left: element.scrollLeft, height: element.clientHeight, width: element.clientWidth })
  }, [])
  const virtualStart = Math.max(0, Math.floor((viewport.top - 64) / ROW_HEIGHT) - 10)
  const virtualEnd = Math.min(visibleTasks.length, Math.ceil((viewport.top + viewport.height - 64) / ROW_HEIGHT) + 10)
  const renderedTasks = visibleTasks.slice(virtualStart, virtualEnd)
  const timelineViewportLeft = Math.max(0, viewport.left - GRID_WIDTH)
  const headerStartIndex = Math.max(0, Math.floor(timelineViewportLeft / dayWidth) - 5)
  const headerEndIndex = Math.min(days.length, Math.ceil((timelineViewportLeft + viewport.width) / dayWidth) + 5)
  const headerDays = days.slice(headerStartIndex, headerEndIndex)
  const gridBackground = useMemo(() => ({
    backgroundImage: `repeating-linear-gradient(to right, transparent 0, transparent ${Math.max(0, dayWidth - 1)}px, rgba(203,213,225,.72) ${Math.max(0, dayWidth - 1)}px, rgba(203,213,225,.72) ${dayWidth}px)`,
    backgroundSize: `${dayWidth}px 100%`,
  }), [dayWidth])

  const flushQueuedSave = useCallback(() => {
    const job = queuedSaveRef.current
    queuedSaveRef.current = null
    if (!job) return
    persistChainRef.current = persistChainRef.current.then(async () => {
      setLoading(true)
      try {
        await api(`${API}/${project.id}/tarefas/lote`, { method: 'PUT', body: JSON.stringify({ tarefas: job.tasks.map(item => ({
          id: item.id, nome: item.nome, parent_id: item.parent_id, ordem: item.ordem,
          data_inicio: dateOnly(item.data_inicio), data_fim: dateOnly(item.data_fim),
          duracao_dias: item.e_marco ? 0 : taskDuration(item), percentual_concluido: item.percentual_concluido,
          e_marco: item.e_marco, inativa: item.inativa, caminho_critico: item.caminho_critico,
          modo_agendamento: item.modo_agendamento, prioridade: item.prioridade,
        })) }) })
        notify(job.message)
      } catch (error) {
        notify(error.message, 'error')
        await reload()
      } finally { setLoading(false) }
    })
  }, [project.id, notify, reload])

  const saveBatch = useCallback((nextTasks, message = 'Alterações salvas', remember = true, immediate = false) => {
    if (!permissions.edit) return
    if (remember) { setHistory(previous => [...previous.slice(-29), deepCopy(tasksRef.current)]); setFuture([]) }
    tasksRef.current = nextTasks
    setTasks(nextTasks)
    queuedSaveRef.current = { tasks: deepCopy(nextTasks), message }
    if (saveTimerRef.current) clearTimeout(saveTimerRef.current)
    if (immediate) flushQueuedSave()
    else saveTimerRef.current = setTimeout(flushQueuedSave, 280)
  }, [permissions.edit, flushQueuedSave])

  const updateTask = useCallback((id, patch, autoschedule = false) => {
    let next = tasks.map(item => Number(item.id) === Number(id) ? { ...item, ...patch } : item)
    if (autoschedule) next = scheduleTasks(next, calendar)
    saveBatch(next)
  }, [tasks, calendar, saveBatch])

  const shiftSummary = useCallback((summaryId, anchorField, targetDate) => {
    const summary = tasks.find(item => Number(item.id) === Number(summaryId))
    const target = dateOnly(targetDate)
    if (!summary || !target) return

    const childrenByParent = new Map()
    tasks.forEach(item => {
      const parentId = item.parent_id == null ? null : Number(item.parent_id)
      if (!childrenByParent.has(parentId)) childrenByParent.set(parentId, [])
      childrenByParent.get(parentId).push(Number(item.id))
    })

    const descendantIds = new Set()
    const stack = [...(childrenByParent.get(Number(summaryId)) || [])]
    while (stack.length) {
      const id = stack.pop()
      if (descendantIds.has(id)) continue
      descendantIds.add(id)
      stack.push(...(childrenByParent.get(id) || []))
    }
    if (!descendantIds.size) return

    if (anchorField === 'data_inicio') {
      const currentStart = dateOnly(summary.data_inicio)
      if (!currentStart) return
      const delta = diffDays(currentStart, target)
      if (!delta) return
      const direction = delta < 0 ? -1 : 1
      const moved = tasks.map(item => {
        if (!descendantIds.has(Number(item.id))) return item
        const itemStart = dateOnly(item.data_inicio)
        const finish = dateOnly(item.data_fim || item.data_inicio)
        const shiftedStart = itemStart ? nextWorkingDay(addCalendarDays(itemStart, delta), calendar, direction, true) : itemStart
        const shiftedFinish = finish ? nextWorkingDay(addCalendarDays(finish, delta), calendar, direction, true) : finish
        return { ...item, data_inicio: shiftedStart, data_fim: item.e_marco ? shiftedStart : shiftedFinish }
      })
      saveBatch(scheduleTasks(moved, calendar), `Grupo "${summary.nome}" movido`)
      return
    }

    const leaves = tasks.filter(item => descendantIds.has(Number(item.id)) && !item.e_resumo && !item.inativa)
    const currentFinish = leaves.map(item => dateOnly(item.data_fim || item.data_inicio)).filter(Boolean).sort().pop()
    if (!currentFinish) return
    const terminalIds = new Set(leaves.filter(item => dateOnly(item.data_fim || item.data_inicio) === currentFinish).map(item => Number(item.id)))
    const resized = tasks.map(item => {
      if (!terminalIds.has(Number(item.id))) return item
      const itemStart = dateOnly(item.data_inicio)
      if (!itemStart) return item
      const safeTarget = dateObj(target) < dateObj(itemStart) ? itemStart : nextWorkingDay(target, calendar, -1, true)
      const duration = workingDaysInclusive(itemStart, safeTarget, calendar)
      const finish = addWorkingDays(itemStart, Math.max(1, duration) - 1, calendar)
      return { ...item, data_fim: finish, duracao_dias: duration, duracao_minutos: duration * 480, e_marco: false }
    })
    saveBatch(scheduleTasks(resized, calendar), `Término do grupo "${summary.nome}" ajustado`)
  }, [tasks, calendar, saveBatch])

  const resizeSummaryDuration = useCallback((summaryId, durationValue) => {
    const summary = tasks.find(item => Number(item.id) === Number(summaryId))
    const startDate = dateOnly(summary?.data_inicio)
    if (!summary || !startDate) return
    const duration = Math.max(1, Math.round(Number(durationValue) || 1))
    shiftSummary(summaryId, 'data_fim', addWorkingDays(startDate, duration - 1, calendar))
  }, [tasks, calendar, shiftSummary])

  const undo = () => {
    if (!history.length) return
    const previous = history[history.length - 1]
    setFuture(items => [deepCopy(tasks), ...items].slice(0, 30))
    setHistory(items => items.slice(0, -1)); saveBatch(previous, 'Alteração desfeita', false)
  }
  const redo = () => {
    if (!future.length) return
    const next = future[0]
    setHistory(items => [...items, deepCopy(tasks)].slice(-30)); setFuture(items => items.slice(1)); saveBatch(next, 'Alteração refeita', false)
  }
  const recalculate = () => saveBatch(scheduleTasks(tasks, calendar), 'Cronograma recalculado')

  const createTask = async parentId => {
    try {
      const task = await api(`${API}/${project.id}/tarefas`, { method: 'POST', body: JSON.stringify({ nome: 'Nova tarefa', parent_id: parentId || null, data_inicio: dateOnly(project.data_inicio) || new Date().toISOString().slice(0, 10), duracao_dias: 1, percentual_concluido: 0 }) })
      await reload(); setSelectedId(task.id)
    } catch (error) { notify(error.message, 'error') }
  }
  const deleteTask = async task => {
    if (!window.confirm(`Excluir a tarefa "${task.nome}"?`)) return
    try { await api(`${API}/${project.id}/tarefas/${task.id}`, { method: 'DELETE' }); setSelectedId(null); await reload(); notify('Tarefa excluída') } catch (error) { notify(error.message, 'error') }
  }
  const reorder = async next => {
    try { await api(`${API}/${project.id}/tarefas/reordenar`, { method: 'POST', body: JSON.stringify({ tarefas: next.map((item, index) => ({ id: item.id, parent_id: item.parent_id, ordem: index + 1 })) }) }); await reload() } catch (error) { notify(error.message, 'error') }
  }
  const move = direction => {
    const index = tasks.findIndex(item => Number(item.id) === Number(selectedId)); if (index < 0) return
    const target = direction === 'up' ? index - 1 : index + 1; if (target < 0 || target >= tasks.length) return
    const next = [...tasks]; const [item] = next.splice(index, 1); next.splice(target, 0, item); reorder(next)
  }
  const dropReorder = targetId => {
    if (!dragTaskId || Number(dragTaskId) === Number(targetId)) return setDragTaskId(null)
    const from = tasks.findIndex(item => Number(item.id) === Number(dragTaskId))
    const to = tasks.findIndex(item => Number(item.id) === Number(targetId))
    if (from < 0 || to < 0) return setDragTaskId(null)
    const next = [...tasks]; const [item] = next.splice(from, 1); next.splice(to, 0, item)
    setTasks(next); tasksRef.current = next; setDragTaskId(null); reorder(next)
  }
  const indent = async () => {
    const index = tasks.findIndex(item => Number(item.id) === Number(selectedId)); if (index <= 0) return
    await api(`${API}/${project.id}/tarefas/${selectedId}`, { method: 'PUT', body: JSON.stringify({ parent_id: tasks[index - 1].id }) }); await reload()
  }
  const outdent = async () => {
    if (!selectedTask?.parent_id) return
    const parent = map.get(Number(selectedTask.parent_id))
    await api(`${API}/${project.id}/tarefas/${selectedId}`, { method: 'PUT', body: JSON.stringify({ parent_id: parent?.parent_id || null }) }); await reload()
  }

  const createVisualLink = useCallback(async targetId => {
    if (!linkSourceId || Number(linkSourceId) === Number(targetId)) return
    try {
      await api(`${API}/${project.id}/dependencias`, { method: 'POST', body: JSON.stringify({ predecessora_id: linkSourceId, sucessora_id: targetId, tipo: 'FS', atraso_minutos: 0 }) })
      setLinkSourceId(null)
      await reload()
      notify('Predecessora criada')
    } catch (error) { notify(error.message, 'error') }
  }, [linkSourceId, project.id, reload, notify])

  const selectTask = useCallback((task, event = {}) => {
    if (linkSourceId) { createVisualLink(task.id); return }
    const index = visibleTasks.findIndex(item => Number(item.id) === Number(task.id))
    if (event.shiftKey && lastSelectedIndexRef.current != null) {
      const startIndex = Math.min(lastSelectedIndexRef.current, index)
      const finishIndex = Math.max(lastSelectedIndexRef.current, index)
      setSelectedIds(new Set(visibleTasks.slice(startIndex, finishIndex + 1).map(item => Number(item.id))))
    } else if (event.ctrlKey || event.metaKey) {
      setSelectedIds(previous => {
        const next = new Set(previous)
        next.has(Number(task.id)) ? next.delete(Number(task.id)) : next.add(Number(task.id))
        return next
      })
      lastSelectedIndexRef.current = index
    } else {
      setSelectedIds(new Set([Number(task.id)]))
      lastSelectedIndexRef.current = index
    }
    setSelectedId(task.id)
  }, [visibleTasks, linkSourceId, createVisualLink])

  const copySelection = useCallback(async () => {
    const ids = selectedIds.size ? selectedIds : new Set(selectedId ? [Number(selectedId)] : [])
    const selected = tasks.filter(item => ids.has(Number(item.id)))
    if (!selected.length) return
    const text = selected.map(item => [item.nome, taskDuration(item), dateOnly(item.data_inicio), dateOnly(item.data_fim), Math.round(item.percentual_concluido || 0)].join('\t')).join('\n')
    try { await navigator.clipboard.writeText(text); notify(`${selected.length} tarefa(s) copiadas`) } catch { notify('Não foi possível acessar a área de transferência', 'error') }
  }, [selectedIds, selectedId, tasks, notify])

  const pasteTasks = useCallback(text => {
    if (!permissions.edit || !selectedId || !text?.trim()) return
    const rows = text.replace(/\r/g, '').split('\n').filter(Boolean).map(row => row.split('\t'))
    const startIndex = tasks.findIndex(item => Number(item.id) === Number(selectedId))
    if (startIndex < 0 || !rows.length) return
    const next = tasks.map((item, index) => {
      const values = rows[index - startIndex]
      if (!values || item.e_resumo) return item
      const patch = { ...item }
      if (values[0]?.trim()) patch.nome = values[0].trim()
      if (values[1] !== '' && Number.isFinite(Number(values[1]))) { patch.duracao_dias = Math.max(0, Number(values[1])); patch.duracao_minutos = patch.duracao_dias * 480; patch.e_marco = patch.duracao_dias === 0 }
      if (/^\d{4}-\d{2}-\d{2}$/.test(values[2] || '')) patch.data_inicio = values[2]
      if (/^\d{4}-\d{2}-\d{2}$/.test(values[3] || '')) patch.data_fim = values[3]
      if (values[4] !== '' && Number.isFinite(Number(values[4]))) patch.percentual_concluido = clamp(values[4], 0, 100)
      return patch
    })
    saveBatch(scheduleTasks(next, calendar), `${rows.length} linha(s) coladas`)
  }, [permissions.edit, selectedId, tasks, calendar, saveBatch])

  const removeSelection = useCallback(async () => {
    const ids = Array.from(selectedIds.size ? selectedIds : new Set(selectedId ? [Number(selectedId)] : []))
    if (!ids.length || !window.confirm(`Excluir ${ids.length} tarefa(s) selecionada(s)?`)) return
    setLoading(true)
    try {
      for (const id of ids) await api(`${API}/${project.id}/tarefas/${id}`, { method: 'DELETE' })
      setSelectedId(null); setSelectedIds(new Set()); await reload(); notify('Tarefas excluídas')
    } catch (error) { notify(error.message, 'error') } finally { setLoading(false) }
  }, [selectedIds, selectedId, project.id, reload, notify])

  useEffect(() => {
    const keydown = event => {
      const tag = event.target?.tagName
      const editing = event.target?.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(tag)
      if (editing) return
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'z') { event.preventDefault(); event.shiftKey ? redo() : undo(); return }
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'y') { event.preventDefault(); redo(); return }
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'c') { event.preventDefault(); copySelection(); return }
      if (event.key === 'Escape') { setLinkSourceId(null); setInspectorOpen(false); return }
      if (event.key === 'Delete' && selectedId && permissions.delete) { event.preventDefault(); removeSelection(); return }
      if ((event.key === 'ArrowUp' || event.key === 'ArrowDown') && visibleTasks.length) {
        event.preventDefault()
        const current = visibleTasks.findIndex(item => Number(item.id) === Number(selectedId))
        const nextIndex = clamp(current + (event.key === 'ArrowUp' ? -1 : 1), 0, visibleTasks.length - 1)
        selectTask(visibleTasks[nextIndex])
      }
    }
    const paste = event => {
      const tag = event.target?.tagName
      if (event.target?.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(tag)) return
      const text = event.clipboardData?.getData('text/plain')
      if (text) { event.preventDefault(); pasteTasks(text) }
    }
    window.addEventListener('keydown', keydown)
    window.addEventListener('paste', paste)
    return () => { window.removeEventListener('keydown', keydown); window.removeEventListener('paste', paste) }
  }, [visibleTasks, selectedId, permissions.delete, copySelection, pasteTasks, removeSelection, selectTask, undo, redo])

  const exportJson = () => {
    const blob = new Blob([JSON.stringify(project, null, 2)], { type: 'application/json' })
    const url = URL.createObjectURL(blob); const anchor = document.createElement('a'); anchor.href = url; anchor.download = `${project.codigo || 'projeto'}.json`; anchor.click(); URL.revokeObjectURL(url)
  }

  const importXml = async event => {
    const file = event.target.files?.[0]; event.target.value = ''
    if (!file) return
    if (!file.name.toLowerCase().endsWith('.xml')) return notify('Exporte o arquivo do Microsoft Project como XML antes de importar.', 'error')
    setLoading(true)
    try {
      const xml = new DOMParser().parseFromString(await file.text(), 'application/xml')
      if (xml.querySelector('parsererror')) throw new Error('XML inválido')
      const text = (node, name) => node.getElementsByTagNameNS('*', name)[0]?.textContent || ''
      const nodes = Array.from(xml.getElementsByTagNameNS('*', 'Task')).filter(node => text(node, 'UID') !== '0')
      const outlineStack = new Map()
      const records = nodes.map((node, sourceIndex) => {
        const oldId = Number(text(node, 'ID') || text(node, 'UID')); const level = Number(text(node, 'OutlineLevel') || 1)
        const parentOldId = level > 1 ? outlineStack.get(level - 1) || null : null
        outlineStack.set(level, oldId); Array.from(outlineStack.keys()).filter(key => key > level).forEach(key => outlineStack.delete(key))
        const durationMatch = text(node, 'Duration').match(/PT(?:(\d+)H)?(?:(\d+)M)?/) || []
        const durationHours = Number(durationMatch[1] || 0) + Number(durationMatch[2] || 0) / 60
        return { node, sourceIndex, oldId, level, parentOldId, payload: { nome: text(node, 'Name') || `Tarefa ${oldId}`, data_inicio: dateOnly(text(node, 'Start')), data_fim: dateOnly(text(node, 'Finish')), duracao_dias: Math.max(text(node, 'Milestone') === '1' ? 0 : 1, Math.round(durationHours / 8)), percentual_concluido: Number(text(node, 'PercentComplete') || 0), e_marco: text(node, 'Milestone') === '1', e_resumo: text(node, 'Summary') === '1' } }
      })
      const idMap = new Map(); const imported = []
      const levels = [...new Set(records.map(item => item.level))].sort((a, b) => a - b)
      for (const level of levels) {
        const createdAtLevel = await Promise.all(records.filter(item => item.level === level).map(async record => {
          const created = await api(`${API}/${project.id}/tarefas`, { method: 'POST', body: JSON.stringify({ ...record.payload, parent_id: record.parentOldId ? idMap.get(record.parentOldId) || null : null }) })
          return { ...record, created }
        }))
        createdAtLevel.forEach(item => { idMap.set(item.oldId, item.created.id); imported.push(item) })
      }
      imported.sort((a, b) => a.sourceIndex - b.sourceIndex)
      await api(`${API}/${project.id}/tarefas/reordenar`, { method: 'POST', body: JSON.stringify({ tarefas: imported.map((item, index) => ({ id: item.created.id, parent_id: item.parentOldId ? idMap.get(item.parentOldId) || null : null, ordem: index + 1 })) }) })
      const typeMap = { 0: 'FF', 1: 'FS', 2: 'SF', 3: 'SS' }
      const dependencyRequests = []
      imported.forEach(({ node, created }) => Array.from(node.getElementsByTagNameNS('*', 'PredecessorLink')).forEach(link => {
        const predecessorId = idMap.get(Number(text(link, 'PredecessorUID')))
        if (!predecessorId) return
        const lagMinutes = Math.round(Number(text(link, 'LinkLag') || 0) / 10)
        dependencyRequests.push(api(`${API}/${project.id}/dependencias`, { method: 'POST', body: JSON.stringify({ predecessora_id: predecessorId, sucessora_id: created.id, tipo: typeMap[Number(text(link, 'Type') || 1)] || 'FS', atraso_minutos: lagMinutes }) }))
      }))
      for (let index = 0; index < dependencyRequests.length; index += 20) await Promise.all(dependencyRequests.slice(index, index + 20))
      await reload(); notify(`${imported.length} tarefas importadas`)
    } catch (error) { notify(error.message, 'error') } finally { setLoading(false) }
  }

  const toggleCollapse = id => setCollapsed(previous => { const next = new Set(previous); next.has(id) ? next.delete(id) : next.add(id); return next })
  const todayX = diffDays(range.start, new Date().toISOString().slice(0, 10)) * dayWidth
  const column = 'border-r px-1'

  return <div className="flex h-screen min-h-0 flex-col bg-slate-50">
    <div className="z-40 border-b bg-white shadow-sm">
      <div className="flex flex-wrap items-center gap-2 px-3 py-2">
        <button onClick={back} className="flex items-center gap-1 rounded-lg border px-3 py-2 text-xs font-bold"><ArrowLeft size={15}/> Projetos</button>
        <div className="min-w-0 flex-1"><div className="flex items-center gap-2"><FolderKanban className="text-blue-600" size={20}/><h1 className="truncate text-base font-black">{project.nome}</h1><StatusBadge status={project.status}/></div><p className="text-[10px] text-slate-400">{project.codigo} · {project.empresa_principal_nome || 'Sem empresa'}</p></div>
        <input ref={importRef} className="hidden" type="file" accept=".xml" onChange={importXml}/>
        <button onClick={() => importRef.current?.click()} className="flex items-center gap-1 rounded-lg border px-3 py-2 text-xs font-bold"><Upload size={15}/> Importar XML</button>
        <button onClick={exportJson} className="flex items-center gap-1 rounded-lg border px-3 py-2 text-xs font-bold"><Download size={15}/> Exportar</button>
        <button onClick={() => setCalendarOpen(true)} className="rounded-lg border p-2" title="Calendário"><CalendarDays size={16}/></button>
        <button onClick={() => setBaselineOpen(true)} className="rounded-lg border p-2" title="Linha de base"><Layers3 size={16}/></button>
        <button onClick={() => setResourcesOpen(true)} className="rounded-lg border p-2" title="Responsáveis"><Users size={16}/></button>
        <button onClick={recalculate} disabled={!permissions.edit} className="flex items-center gap-1 rounded-lg bg-black px-3 py-2 text-xs font-bold text-white disabled:opacity-40"><RefreshCw size={15}/> Recalcular</button>
      </div>
      <div className="flex flex-wrap items-center gap-1 border-t bg-slate-50 px-3 py-1.5">
        <button disabled={!permissions.edit} onClick={() => createTask(null)} className="flex items-center gap-1 rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-bold text-white disabled:opacity-40"><Plus size={14}/> Tarefa</button>
        <button disabled={!permissions.edit || !selectedId} onClick={() => createTask(selectedId)} className="flex items-center gap-1 rounded-lg border bg-white px-3 py-1.5 text-xs font-bold disabled:opacity-40"><Plus size={14}/> Subtarefa</button>
        <button disabled={!selectedId} onClick={() => setDependencyOpen(true)} className="flex items-center gap-1 rounded-lg border bg-white px-3 py-1.5 text-xs font-bold disabled:opacity-40"><Link2 size={14}/> Dependência</button>
        <button disabled={!selectedId || !permissions.edit} onClick={() => setLinkSourceId(value => value ? null : selectedId)} className={`flex items-center gap-1 rounded-lg border px-3 py-1.5 text-xs font-bold disabled:opacity-40 ${linkSourceId ? 'border-blue-600 bg-blue-600 text-white' : 'bg-white'}`}><Link2 size={14}/>{linkSourceId ? 'Clique na sucessora' : 'Vincular'}</button>
        <button disabled={!selectedId} onClick={() => setResourcesOpen(true)} className="flex items-center gap-1 rounded-lg border bg-white px-3 py-1.5 text-xs font-bold disabled:opacity-40"><UserPlus size={14}/> Atribuir Responsáveis</button>
        <button disabled={!selectedId} onClick={copySelection} className="rounded-lg border bg-white px-3 py-1.5 text-xs font-bold disabled:opacity-40">Copiar</button>
        <button disabled={!selectedId} onClick={() => setInspectorOpen(true)} className="rounded-lg border bg-white px-3 py-1.5 text-xs font-bold disabled:opacity-40">Detalhes</button>
        <button disabled={!selectedId || !permissions.delete} onClick={removeSelection} className="rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs font-bold text-red-600 disabled:opacity-40">Excluir</button>
        <span className="mx-1 h-6 w-px bg-slate-300"/>
        <button disabled={!history.length} onClick={undo} className="rounded-lg border bg-white p-2 disabled:opacity-30" title="Desfazer"><Undo2 size={14}/></button><button disabled={!future.length} onClick={redo} className="rounded-lg border bg-white p-2 disabled:opacity-30" title="Refazer"><Redo2 size={14}/></button>
        <button disabled={!selectedId} onClick={() => move('up')} className="rounded-lg border bg-white p-2 disabled:opacity-30"><ArrowUp size={14}/></button><button disabled={!selectedId} onClick={() => move('down')} className="rounded-lg border bg-white p-2 disabled:opacity-30"><ArrowDown size={14}/></button><button disabled={!selectedId} onClick={outdent} className="rounded-lg border bg-white p-2 disabled:opacity-30"><ArrowLeft size={14}/></button><button disabled={!selectedId} onClick={indent} className="rounded-lg border bg-white p-2 disabled:opacity-30"><ArrowRight size={14}/></button>
        <div className="ml-2 flex items-center rounded-lg border bg-white p-1"><button disabled={zoomIndex === 0} onClick={() => setZoomIndex(index => Math.max(0, index - 1))} className="p-1 disabled:opacity-30"><ZoomIn size={14}/></button><span className="w-14 text-center text-[10px] font-bold">{zoom.label}</span><button disabled={zoomIndex === ZOOMS.length - 1} onClick={() => setZoomIndex(index => Math.min(ZOOMS.length - 1, index + 1))} className="p-1 disabled:opacity-30"><ZoomOut size={14}/></button></div>
        <select value={filter} onChange={event => setFilter(event.target.value)} className="ml-auto rounded-lg border bg-white px-2 py-1.5 text-xs font-bold outline-none"><option value="all">Todas</option><option value="open">Em aberto</option><option value="late">Atrasadas</option><option value="critical">Caminho crítico</option><option value="done">Concluídas</option></select>
        <div className="relative"><Search className="absolute left-2 top-1/2 -translate-y-1/2 text-slate-400" size={13}/><input value={search} onChange={event => setSearch(event.target.value)} placeholder="Localizar tarefa" className="w-52 rounded-lg border bg-white py-1.5 pl-8 pr-2 text-xs outline-none"/></div>
      </div>
    </div>

    <div ref={scrollRef} onScroll={onViewportScroll} className="min-h-0 flex-1 overflow-auto bg-white">
      <div style={{ minWidth: GRID_WIDTH + timelineWidth }}>
        <div className="sticky top-0 z-30 flex h-16 border-b bg-white">
          <div className="sticky left-0 z-30 flex shrink-0 border-r bg-slate-100 text-[9px] font-black uppercase text-slate-500" style={{ width: GRID_WIDTH }}>
            <div className={`${column} flex w-14 items-center justify-center`}>WBS</div><div className={`${column} flex w-9 items-center justify-center`}>I</div><div className={`${column} flex w-[300px] items-center`}>Nome da tarefa</div><div className={`${column} flex w-20 items-center`}>Duração</div><div className={`${column} flex w-28 items-center`}>Início</div><div className={`${column} flex w-28 items-center`}>Término</div><div className={`${column} flex w-24 items-center`}>Predecessoras</div><div className={`${column} flex w-36 items-center`}>Responsável</div><div className={`${column} flex w-20 items-center`}>% concl.</div><div className="flex w-16 items-center justify-center">Ações</div>
          </div>
          <div className="relative h-16 shrink-0" style={{ width: timelineWidth, ...gridBackground }}>
            {headerDays.map((day, localIndex) => { const index = headerStartIndex + localIndex; const date = dateObj(day); const weekend = !isWorkingDay(day, calendar); const show = zoom.key === 'dia' || (zoom.key === 'semana' && date.getDay() === 1) || (zoom.key === 'mes' && date.getDate() === 1) || (zoom.key === 'ano' && date.getMonth() === 0 && date.getDate() === 1); return <div key={day} className={`${weekend ? 'bg-slate-50/70' : ''} absolute inset-y-0`} style={{ left: index * dayWidth, width: dayWidth }}>{show && <span className="absolute left-1 top-2 whitespace-nowrap text-[9px] font-bold text-slate-500">{zoom.key === 'ano' ? date.getFullYear() : zoom.key === 'mes' ? date.toLocaleDateString('pt-BR', { month: 'short', year: '2-digit' }) : date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' })}</span>}{zoom.key === 'dia' && <span className="absolute bottom-2 left-1/2 -translate-x-1/2 text-[9px] text-slate-400">{['D','S','T','Q','Q','S','S'][date.getDay()]}</span>}</div> })}
            {todayX >= 0 && todayX <= timelineWidth && <div className="absolute inset-y-0 z-20 w-0.5 bg-red-500" style={{ left: todayX }}><span className="absolute left-1 top-0 rounded bg-red-500 px-1 text-[8px] font-bold text-white">Hoje</span></div>}
          </div>
        </div>
        <div className="relative" style={{ height: visibleTasks.length * ROW_HEIGHT }}>
          {renderedTasks.map((task, localIndex) => {
            const rowIndex = virtualStart + localIndex
            const selected = selectedIds.has(Number(task.id)) || Number(selectedId) === Number(task.id); const children = childIds.has(Number(task.id)); const resourcesText = (task.alocacoes || []).map(item => item.recurso_nome).filter(Boolean).join(', ')
            return <div key={task.id} className={`absolute left-0 flex border-b ${selected ? 'bg-blue-50' : 'bg-white hover:bg-slate-50'} ${Number(linkSourceId) === Number(task.id) ? 'ring-2 ring-inset ring-blue-500' : ''} ${Number(dragTaskId) === Number(task.id) ? 'opacity-50' : ''}`} style={{ top: rowIndex * ROW_HEIGHT, height: ROW_HEIGHT, width: GRID_WIDTH + timelineWidth }} onClick={event => selectTask(task, event)} onDoubleClick={() => { setSelectedId(task.id); setInspectorOpen(true) }} onDragOver={event => event.preventDefault()} onDrop={event => { event.preventDefault(); dropReorder(task.id) }}>
              <div className={`sticky left-0 z-20 flex shrink-0 border-r ${selected ? 'bg-blue-50' : 'bg-white'}`} style={{ width: GRID_WIDTH }}>
                <div className={`${column} flex w-14 items-center justify-center text-[9px] text-slate-400`}>{task.wbs || task.id}</div>
                <div className={`${column} flex w-9 items-center justify-center`}>{task.caminho_critico ? <AlertTriangle className="text-red-500" size={12}/> : task.e_marco ? <Milestone className="text-violet-500" size={12}/> : null}</div>
                <div className={`${column} flex w-[300px] items-center`}><button type="button" draggable={permissions.edit} onDragStart={event => { event.stopPropagation(); setDragTaskId(task.id); event.dataTransfer.effectAllowed = 'move' }} onDragEnd={() => setDragTaskId(null)} className="cursor-grab"><GripVertical className="shrink-0 text-slate-300" size={12}/></button><span className="shrink-0" style={{ width: Number(task.nivel || 0) * 16 }}/>{children ? <button onClick={event => { event.stopPropagation(); toggleCollapse(Number(task.id)) }} className="mr-1">{collapsed.has(Number(task.id)) ? <ChevronRight size={13}/> : <ChevronDown size={13}/>}</button> : <span className="mr-1 w-[13px]"/>}<input disabled={!permissions.edit} defaultValue={task.nome} onFocus={() => { setSelectedId(task.id); setSelectedIds(new Set([Number(task.id)])) }} onClick={event => event.stopPropagation()} onBlur={event => { const name = event.target.value.trim(); if (name && name !== task.nome) updateTask(task.id, { nome: name }) }} className={`min-w-0 flex-1 bg-transparent text-xs outline-none ${task.e_resumo ? 'font-black' : 'font-medium'}`}/></div>
                <div className={`${column} flex w-20 items-center justify-center`}><DurationEditor task={task} editable={permissions.edit} calendar={calendar} apply={patch => task.e_resumo ? resizeSummaryDuration(task.id, patch.duracao_dias) : updateTask(task.id, patch, true)}/></div>
                <div className={`${column} flex w-28 items-center`}><DateEditor task={task} field="data_inicio" editable={permissions.edit} apply={value => task.e_resumo ? shiftSummary(task.id, 'data_inicio', value) : updateTask(task.id, { data_inicio: value }, true)}/></div>
                <div className={`${column} flex w-28 items-center`}><DateEditor task={task} field="data_fim" editable={permissions.edit} apply={value => task.e_resumo ? shiftSummary(task.id, 'data_fim', value) : updateTask(task.id, { data_fim: value })}/></div>
                <button onClick={event => { event.stopPropagation(); setSelectedId(task.id); setDependencyOpen(true) }} className={`${column} w-24 truncate text-left text-[10px] text-slate-500 hover:bg-blue-50`}>{(task.predecessoras || []).map(item => `${item.predecessora_id}${item.tipo}`).join(', ') || '—'}</button>
                <button onClick={event => { event.stopPropagation(); setSelectedId(task.id); setResourcesOpen(true) }} className={`${column} w-36 truncate text-left text-[10px] text-slate-500 hover:bg-blue-50`}>{resourcesText || '—'}</button>
                <div className={`${column} flex w-20 items-center justify-center`}><input disabled={!permissions.edit || task.e_resumo} type="number" min="0" max="100" value={Math.round(task.percentual_concluido || 0)} onChange={event => updateTask(task.id, { percentual_concluido: clamp(event.target.value, 0, 100) })} className="w-10 bg-transparent text-right text-[10px] outline-none"/><span className="text-[9px] text-slate-400">%</span></div>
                <div className="flex w-16 items-center justify-center gap-1"><button disabled={!permissions.edit} title="Subtarefa" onClick={event => { event.stopPropagation(); createTask(task.id) }} className="rounded p-1 text-blue-600 hover:bg-blue-100 disabled:opacity-30"><Plus size={13}/></button><button disabled={!permissions.delete} title="Excluir" onClick={event => { event.stopPropagation(); deleteTask(task) }} className="rounded p-1 text-red-500 hover:bg-red-100 disabled:opacity-30"><Trash2 size={13}/></button></div>
              </div>
              <div className="relative shrink-0" style={{ width: timelineWidth, ...gridBackground }}>
                {todayX >= 0 && todayX <= timelineWidth && <div className="absolute inset-y-0 z-[7] w-0.5 bg-red-400" style={{ left: todayX }}/>} 
                <GanttBar task={task} timelineStart={range.start} dayWidth={dayWidth} selected={selected} baseline={baselineMap.get(Number(task.id))} select={() => selectTask(task)} change={patch => task.e_resumo ? shiftSummary(task.id, 'data_inicio', patch.data_inicio) : updateTask(task.id, patch, true)} editable={permissions.edit} calendar={calendar}/>
              </div>
            </div>
          })}
          <div className="absolute left-[1020px] top-0" style={{ width: timelineWidth, height: visibleTasks.length * ROW_HEIGHT }}><DependencyLayer tasks={renderedTasks} rowOffset={virtualStart} totalRows={visibleTasks.length} timelineStart={range.start} dayWidth={dayWidth} width={timelineWidth}/></div>
        </div>
      </div>
    </div>
    <div className="flex flex-wrap items-center gap-5 border-t bg-white px-4 py-2 text-[10px] text-slate-500"><span><b>{tasks.length}</b> tarefas</span>{selectedIds.size > 1 && <span className="font-bold text-blue-600">{selectedIds.size} selecionadas</span>}<span>Progresso: <b>{Math.round(project.percentual_concluido || 0)}%</b></span><span>{formatDate(project.data_inicio)} → <b>{formatDate(project.data_fim_prevista)}</b></span><span className="hidden xl:inline">Shift+clique seleciona · Ctrl+C/Ctrl+V copia e cola · Delete exclui</span>{loading && <span className="ml-auto flex items-center gap-1"><Loader2 className="animate-spin" size={12}/> Salvando</span>}</div>

    {dependencyOpen && selectedTask && <DependencyModal project={project} task={selectedTask} tasks={tasks} reload={reload} close={() => setDependencyOpen(false)} notify={notify}/>} 
    {resourcesOpen && <ResourcesModal project={project} task={selectedTask} resources={resources} users={users} reload={reload} close={() => setResourcesOpen(false)} notify={notify}/>} 
    {calendarOpen && <CalendarModal project={project} calendars={calendars} reload={reload} close={() => setCalendarOpen(false)} notify={notify}/>} 
    {baselineOpen && <BaselineModal project={project} baselines={baselines} selectedId={selectedBaselineId} select={setSelectedBaselineId} reload={reload} close={() => setBaselineOpen(false)} notify={notify}/>} 
    {inspectorOpen && selectedTask && <TaskInspector task={selectedTask} selectedCount={selectedIds.size || 1} calendar={calendar} editable={permissions.edit} close={() => setInspectorOpen(false)} update={patch => updateTask(selectedTask.id, patch)} updateDuration={patch => selectedTask.e_resumo ? resizeSummaryDuration(selectedTask.id, patch.duracao_dias) : updateTask(selectedTask.id, patch, true)} updateStart={value => selectedTask.e_resumo ? shiftSummary(selectedTask.id, 'data_inicio', value) : updateTask(selectedTask.id, { data_inicio: value }, true)} updateFinish={value => selectedTask.e_resumo ? shiftSummary(selectedTask.id, 'data_fim', value) : updateTask(selectedTask.id, { data_fim: value })} dependencies={() => setDependencyOpen(true)} resources={() => setResourcesOpen(true)}/>} 
  </div>
}

const arrayResult = (value, keys = []) => {
  if (Array.isArray(value)) return value
  for (const key of keys) if (Array.isArray(value?.[key])) return value[key]
  return []
}

const projectResult = value => value?.projeto || value?.data || value

export default function Projeto() {
  const auth = useAuth()
  const user = auth?.user || null
  const [projects, setProjects] = useState([])
  const [companies, setCompanies] = useState([])
  const [groups, setGroups] = useState([])
  const [users, setUsers] = useState([])
  const [dashboard, setDashboard] = useState(null)
  const [loading, setLoading] = useState(true)
  const [saving, setSaving] = useState(false)
  const [activeProject, setActiveProject] = useState(null)
  const [editingProject, setEditingProject] = useState(null)
  const [formOpen, setFormOpen] = useState(false)
  const [toast, setToast] = useState(null)

  const notify = useCallback((message, type = 'success') => {
    setToast({ message, type })
    window.setTimeout(() => setToast(null), 3500)
  }, [])

  const role = String(user?.role || user?.tipo || user?.tipo_usuario || '').toLowerCase()
  const profile = user?.perfil_acesso || user?.perfil || null
  const projectPermission = useCallback(action => {
    if (['admin', 'super_admin', 'superadmin'].includes(role)) return true
    const key = `projetos_${action}`
    if (profile && Object.prototype.hasOwnProperty.call(profile, key)) return !!profile[key]
    // Até os novos campos entrarem no perfil, o módulo permanece visível;
    // o backend continua sendo a autoridade final para cada alteração.
    return action === 'ver'
  }, [profile, role])

  const permissions = useMemo(() => ({
    view: projectPermission('ver'),
    create: projectPermission('criar'),
    edit: projectPermission('editar'),
    delete: projectPermission('excluir'),
  }), [projectPermission])

  const load = useCallback(async () => {
    setLoading(true)
    const results = await Promise.allSettled([
      api(API),
      api(`${API}/dashboard`),
      api(`${API}/grupos`),
      api('/api/empresas'),
      api('/api/usuarios'),
    ])
    if (results[0].status === 'fulfilled') setProjects(arrayResult(results[0].value, ['projetos', 'items', 'data']))
    else notify(results[0].reason?.message || 'Não foi possível carregar os projetos', 'error')
    if (results[1].status === 'fulfilled') setDashboard(results[1].value?.dashboard || results[1].value)
    if (results[2].status === 'fulfilled') setGroups(arrayResult(results[2].value, ['grupos', 'items', 'data']))
    if (results[3].status === 'fulfilled') setCompanies(arrayResult(results[3].value, ['empresas', 'items', 'data']))
    if (results[4].status === 'fulfilled') setUsers(arrayResult(results[4].value, ['usuarios', 'users', 'items', 'data']))
    setLoading(false)
  }, [notify])

  useEffect(() => { if (permissions.view) load() }, [load, permissions.view])

  const openProject = async project => {
    try {
      const full = projectResult(await api(`${API}/${project.id}`))
      setActiveProject(full)
    } catch (error) { notify(error.message, 'error') }
  }

  const openCreate = () => { setEditingProject(null); setFormOpen(true) }
  const openEdit = project => { setEditingProject(project); setFormOpen(true) }

  const saveProject = async payload => {
    setSaving(true)
    try {
      const method = editingProject ? 'PUT' : 'POST'
      const url = editingProject ? `${API}/${editingProject.id}` : API
      const result = projectResult(await api(url, { method, body: JSON.stringify(payload) }))
      setFormOpen(false); setEditingProject(null)
      await load(); notify(editingProject ? 'Projeto atualizado' : 'Projeto criado')
      if (!editingProject && result?.id) await openProject(result)
    } catch (error) { notify(error.message, 'error') } finally { setSaving(false) }
  }

  const removeProject = async project => {
    if (!window.confirm(`Excluir o projeto "${project.nome}"? Esta operação não pode ser desfeita.`)) return
    try { await api(`${API}/${project.id}`, { method: 'DELETE' }); await load(); notify('Projeto excluído') } catch (error) { notify(error.message, 'error') }
  }

  const createGroup = async () => {
    const nome = window.prompt('Nome do novo grupo / portfólio:')
    if (!nome?.trim()) return
    try { await api(`${API}/grupos`, { method: 'POST', body: JSON.stringify({ nome: nome.trim() }) }); await load(); notify('Grupo criado') } catch (error) { notify(error.message, 'error') }
  }

  if (!permissions.view) return <div className="flex min-h-[60vh] items-center justify-center p-6"><div className="max-w-md rounded-2xl border bg-white p-8 text-center shadow-sm"><AlertTriangle className="mx-auto mb-3 text-amber-500" size={36}/><h1 className="text-xl font-black">Acesso não autorizado</h1><p className="mt-2 text-sm text-slate-500">Seu perfil não possui permissão para visualizar projetos.</p></div></div>

  return <>
    {activeProject
      ? <Workspace initialProject={activeProject} users={users} permissions={permissions} back={() => { setActiveProject(null); load() }} notify={notify}/>
      : <Portfolio projects={projects} dashboard={dashboard} companies={companies} groups={groups} loading={loading} create={openCreate} createGroup={createGroup} edit={openEdit} open={openProject} remove={removeProject} permissions={permissions}/>
    }
    <Modal open={formOpen} wide title={editingProject ? 'Editar projeto' : 'Novo projeto'} close={() => { setFormOpen(false); setEditingProject(null) }}>
      <ProjectForm key={editingProject?.id || 'new'} project={editingProject} companies={companies} groups={groups} users={users} saving={saving} save={saveProject} cancel={() => { setFormOpen(false); setEditingProject(null) }}/>
    </Modal>
    <Toast value={toast} close={() => setToast(null)}/>
  </>
}
